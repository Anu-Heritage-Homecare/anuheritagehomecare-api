// A family owner's private, read only calendar feed. The token in the feed URL is
// the only credential a calendar app can present, so it is a long random secret.
// One per owner; regenerating rotates the token. Owned by the profile context.
model CalendarFeed {
  userId    String   @id @db.Uuid
  token     String   @unique @db.VarChar(64)
  createdAt DateTime @default(now())

  @@map("calendar_feeds")
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID

  @@map("invoice_status")
}

// A bill issued to a family owner for one monthly subscription period. Written by
// the billing run; money is in integer minor units. One per subscription period.
model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  ownerId         String        @db.Uuid
  careRecipientId String        @db.Uuid
  subscriptionId  String        @db.Uuid
  number          String        @unique @db.VarChar(40)
  currency        Currency
  // Money breakdown, snapshotted at issue: subtotal is the sum of the line items,
  // tax is derived from the rate, and amountMinor is the charged total (subtotal
  // plus tax less discount).
  subtotalMinor   Int
  taxRateBps      Int           @default(0)
  taxMinor        Int           @default(0)
  discountMinor   Int           @default(0)
  amountMinor     Int
  periodStart     DateTime      @db.Date
  periodEnd       DateTime      @db.Date
  dueDate         DateTime      @db.Date
  status          InvoiceStatus @default(ISSUED)
  issuedAt        DateTime      @default(now())
  paidAt          DateTime?

  lineItems InvoiceLineItem[]

  @@unique([subscriptionId, periodStart])
  @@index([ownerId, periodStart])
  @@map("invoices")
}

// One service or charge line on an invoice, snapshotted at issue and ordered by
// position. Owned by the Invoice and replaced wholesale when the invoice is saved.
model InvoiceLineItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  description String   @db.VarChar(200)
  amountMinor Int
  position    Int
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

enum BillingModel {
