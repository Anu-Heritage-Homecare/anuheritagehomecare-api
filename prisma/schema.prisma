// Prisma schema for the Anu Heritage Homecare API.
// Docs: https://www.prisma.io/docs
//
// Persistence is an infrastructure concern. Prisma models below are database
// rows only. They are mapped to and from rich domain entities inside each
// bounded context's infrastructure layer, so the domain never depends on Prisma.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Sample bounded context: Clients (care recipients).
model Client {
  id        String       @id @default(uuid()) @db.Uuid
  firstName String       @db.VarChar(100)
  lastName  String       @db.VarChar(100)
  email     String       @unique @db.VarChar(255)
  phone     String       @db.VarChar(32)
  status    ClientStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status])
  @@map("clients")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("client_status")
}

// Bounded context: Identity (mobile users, authentication).
//
// A user is a caregiver or a family member. Family owners self register on the
// mobile app; caregivers are onboarded later. Credentials, one time codes and
// refresh tokens are always stored hashed, never in clear.
model User {
  id            String     @id @default(uuid()) @db.Uuid
  userType      UserType
  firstName     String     @db.VarChar(100)
  lastName      String     @db.VarChar(100)
  email         String     @unique @db.VarChar(255)
  phone         String     @unique @db.VarChar(20)
  addressLine1  String     @db.VarChar(200)
  addressLine2  String?    @db.VarChar(200)
  city          String     @db.VarChar(120)
  state         String     @db.VarChar(120)
  postalCode    String     @db.VarChar(20)
  country       Country
  passwordHash  String     @db.VarChar(255)
  emailVerified Boolean    @default(false)
  phoneVerified Boolean    @default(false)
  isFamilyOwner Boolean    @default(false)
  // True for an account provisioned with a temporary password (for example a
  // caregiver onboarded by an admin). Login still succeeds but signals the client
  // to force a password change; any password change clears the flag.
  mustChangePassword Boolean @default(false)
  status        UserStatus @default(PENDING_VERIFICATION)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  verificationCodes VerificationCode[]
  refreshTokens     RefreshToken[]

  @@index([status])
  @@map("users")
}

// One time passcode issued for email verification or password reset. The code
// itself is stored only as a hash; expiry, single use and attempt caps are
// enforced in the domain.
model VerificationCode {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    VerificationPurpose
  codeHash   String              @db.VarChar(255)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                 @default(0)
  createdAt  DateTime            @default(now())

  @@index([userId, purpose])
  @@map("verification_codes")
}

// Persisted refresh token (stored hashed) enabling rotation and revocation.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum UserType {
  CAREGIVER
  FAMILY_MEMBER

  @@map("user_type")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum Country {
  US
  NG

  @@map("country")
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("verification_purpose")
}

// Bounded context: Care recipients (the "loved one" a family owner onboards).
//
// A family owner creates a digital identity for each member receiving care
// through a multi step wizard. The record is created as a DRAFT holding the
// identity profile, then progressively enriched with care needs, health and
// medication information and a care schedule before being finalised (ACTIVE).
//
// `ownerId` references the identity User aggregate by id only. Aggregates in
// different bounded contexts are linked by identifier without a database foreign
// key, so each context owns its own consistency boundary. Health and medication
// data is sensitive personal data and is never logged.
model CareRecipient {
  id      String              @id @default(uuid()) @db.Uuid
  ownerId String              @db.Uuid
  status  CareRecipientStatus @default(DRAFT)

  // Resume pointer: the wizard step to send the owner back to if they leave and
  // return mid onboarding.
  onboardingStep OnboardingStep @default(CARE_NEEDS)

  // Step 1: identity profile (always present from draft creation).
  name            String   @db.VarChar(200)
  gender          Gender
  dateOfBirth     DateTime @db.Date
  city            String   @db.VarChar(120)
  state           String   @db.VarChar(120)
  fullAddress     String   @db.VarChar(300)
  relationship    String   @db.VarChar(120)
  livingSituation String   @db.VarChar(120)
  photoKey        String?  @db.VarChar(500)

  // Pinned location of the address, captured at onboarding. Required before a
  // caregiver can clock in, since the arrival geofence is computed against it.
  latitude  Float?
  longitude Float?

  // Step 2: care needs (empty until the step is completed).
  careNeeds CareNeed[] @default([])

  // Step 3: health and medication information (null until the step is completed).
  medicalConditions  String[] @default([])
  allergies          String[] @default([])
  needsMedicationHelp Boolean?
  medications        String[] @default([])

  // Step 4: care schedule (null until the step is completed).
  careFrequency     CareFrequency?
  estimatedStartDate DateTime?     @db.Date
  expectedDuration  String?        @db.VarChar(120)

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerId])
  @@index([ownerId, status])
  @@map("care_recipients")
}

enum CareRecipientStatus {
  DRAFT
  ACTIVE

  @@map("care_recipient_status")
}

enum Gender {
  MALE
  FEMALE

  @@map("gender")
}

enum CareNeed {
  BATHING
  DRESSING
  GROOMING
  TOILETING
  MEAL_PREPARATION
  HOUSEKEEPING
  LAUNDRY
  SHOPPING

  @@map("care_need")
}

enum CareFrequency {
  ONE_TIME_VISIT
  DAILY
  WEEKLY
  LIVE_IN_CARE

  @@map("care_frequency")
}

enum OnboardingStep {
  PROFILE
  CARE_NEEDS
  HEALTH
  SCHEDULE
  REVIEW
  COMPLETED

  @@map("onboarding_step")
}

// Bounded context: Care plans (the catalog the family owner chooses from).
//
// Reference data: the four plans, how each is billed, the hour options for the
// hourly plan, and the price in each supported currency. Money is stored as an
// integer number of minor units (cents, kobo) to avoid floating point rounding.
model CarePlan {
  id           String       @id @default(uuid()) @db.Uuid
  type         CarePlanType @unique
  name         String       @db.VarChar(120)
  description  String       @db.VarChar(300)
  billingModel BillingModel
  allowedHours Int[]        @default([])
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  prices CarePlanPrice[]

  @@map("care_plans")
}

// The price of a plan in one currency. `unitAmountMinor` is the hourly rate for
// an hourly plan or the monthly price for a monthly plan.
model CarePlanPrice {
  id              String   @id @default(uuid()) @db.Uuid
  planId          String   @db.Uuid
  plan            CarePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  currency        Currency
  unitAmountMinor Int
  serviceFeeMinor Int      @default(0)

  // Recurring billing references at the provider for monthly plans: a Stripe
  // recurring Price id (USD) and a Paystack plan code (NGN).
  stripePriceId    String? @db.VarChar(200)
  paystackPlanCode String? @db.VarChar(200)

  @@unique([planId, currency])
  @@map("care_plan_prices")
}

// Bounded context: Bookings (a one time hourly booking for the Flexible plan).
//
// Pricing is snapshotted at creation so later catalog changes never rewrite past
// orders. `ownerId` and `careRecipientId` reference other contexts by id only.
model Booking {
  id              String       @id @default(uuid()) @db.Uuid
  ownerId         String       @db.Uuid
  careRecipientId String       @db.Uuid
  planType        CarePlanType
  hours           Int
  serviceDate     DateTime     @db.Date
  startMinute     Int
  endMinute       Int
  currency        Currency
  hourlyRateMinor Int
  subtotalMinor   Int
  serviceFeeMinor Int
  totalMinor      Int
  status          BookingStatus @default(PENDING_PAYMENT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([ownerId])
  @@index([careRecipientId])
  @@map("bookings")
}

// A scheduled care session assigning a caregiver to a care recipient on a given
// day and time window. How visits are created and assigned (from bookings and
// subscriptions, or by an admin) is not built yet; this models the execution
// record the caregiver schedule reads. Recipient facing detail (name, health,
// address) is not duplicated here; it is read from the care recipients context.
model Visit {
  id                  String      @id @default(uuid()) @db.Uuid
  caregiverId         String      @db.Uuid
  careRecipientId     String      @db.Uuid
  scheduledDate       DateTime    @db.Date
  startMinute         Int
  endMinute           Int
  status              VisitStatus @default(SCHEDULED)
  specialInstructions String[]
  // Attendance, stamped server side when the caregiver clocks in and out. The
  // arrival coordinates record where the geofenced clock in was accepted.
  clockInAt         DateTime?
  clockOutAt        DateTime?
  arrivalLatitude   Float?
  arrivalLongitude  Float?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  tasks VisitTask[]

  @@index([caregiverId, scheduledDate])
  @@index([careRecipientId])
  @@map("visits")
}

// A single task on a visit checklist (for example Blood Pressure, Meal
// Preparation). Owned by the Visit aggregate and replaced wholesale on save.
model VisitTask {
  id        String  @id @default(uuid()) @db.Uuid
  visitId   String  @db.Uuid
  label     String  @db.VarChar(200)
  completed Boolean @default(false)
  position  Int

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("visit_tasks")
}

// A recurring monthly subscription for the Standard, Premium or Live in plans.
model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  ownerId           String             @db.Uuid
  careRecipientId   String             @db.Uuid
  planType          CarePlanType
  startDate         DateTime           @db.Date
  currency          Currency
  monthlyPriceMinor Int
  status            SubscriptionStatus @default(PENDING_PAYMENT)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([ownerId])
  @@index([careRecipientId])
  @@map("subscriptions")
}

enum Currency {
  USD
  NGN

  @@map("currency")
}

enum BillingModel {
  HOURLY
  MONTHLY

  @@map("billing_model")
}

enum CarePlanType {
  FLEXIBLE
  STANDARD_MONTHLY
  PREMIUM
  LIVE_IN

  @@map("care_plan_type")
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED

  @@map("booking_status")
}

enum VisitStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  MISSED

  @@map("visit_status")
}

// A single location breadcrumb reported by a caregiver's device. Append only and
// high volume: written in batches and read later for the admin movement audit
// (path replay, travel time, long stops). Sent frequently during navigation and
// occasionally in the background, distinguished by `mode`. `visitId` is an
// optional tag; it is not a foreign key so telemetry never blocks on a visit row.
model LocationPing {
  id             String       @id @default(uuid()) @db.Uuid
  caregiverId    String       @db.Uuid
  visitId        String?      @db.Uuid
  latitude       Float
  longitude      Float
  accuracyMeters Float?
  mode           LocationMode
  recordedAt     DateTime
  receivedAt     DateTime     @default(now())

  @@index([caregiverId, recordedAt])
  @@index([visitId])
  @@map("location_pings")
}

enum LocationMode {
  NAVIGATION
  BACKGROUND

  @@map("location_mode")
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  CANCELLED

  @@map("subscription_status")
}

// Bounded context: Payments.
//
// A payment charges for a booking or a subscription through a provider chosen by
// the owner's currency (Stripe for USD, Paystack for NGN). The provider is the
// source of truth for the outcome, confirmed through verification and webhooks.
model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  ownerId           String          @db.Uuid
  payableType       PayableType
  payableId         String          @db.Uuid
  provider          PaymentProvider
  providerReference String          @unique @db.VarChar(200)
  currency          Currency
  amountMinor       Int
  status            PaymentStatus   @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([ownerId])
  @@index([payableType, payableId])
  @@map("payments")
}

// A saved card, tokenised by the provider. The raw card is never stored; only an
// opaque provider reference plus display metadata (brand, last four).
model PaymentMethod {
  id                  String          @id @default(uuid()) @db.Uuid
  ownerId             String          @db.Uuid
  provider            PaymentProvider
  providerCustomerRef String?         @db.VarChar(200)
  providerMethodRef   String          @db.VarChar(200)
  brand               String          @db.VarChar(40)
  last4               String          @db.VarChar(4)
  expMonth            Int
  expYear             Int
  isDefault           Boolean         @default(false)
  createdAt           DateTime        @default(now())

  @@index([ownerId])
  @@map("payment_methods")
}

enum PaymentProvider {
  STRIPE
  PAYSTACK

  @@map("payment_provider")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED

  @@map("payment_status")
}

enum PayableType {
  BOOKING
  SUBSCRIPTION

  @@map("payable_type")
}

// Bounded context: KYC (identity verification of the family owner).
//
// US owners verify the last four of their SSN through Stripe; Nigeria owners
// verify a NIN or international passport through QoreID. Only a masked reference
// (last four) and the provider's reference are stored, never the full number.
model KycVerification {
  id                String          @id @default(uuid()) @db.Uuid
  ownerId           String          @unique @db.Uuid
  country           Country
  provider          KycProvider
  documentType      KycDocumentType
  maskedReference   String          @db.VarChar(20)
  providerReference String?         @db.VarChar(200)
  status            KycStatus       @default(PENDING)
  verifiedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("kyc_verifications")
}

enum KycProvider {
  STRIPE
  QOREID

  @@map("kyc_provider")
}

enum KycStatus {
  PENDING
  VERIFIED
  FAILED

  @@map("kyc_status")
}

enum KycDocumentType {
  SSN_LAST4
  NIN
  PASSPORT

  @@map("kyc_document_type")
}
