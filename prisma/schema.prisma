// Prisma schema for the Anu Heritage Homecare API.
// Docs: https://www.prisma.io/docs
//
// Persistence is an infrastructure concern. Prisma models below are database
// rows only. They are mapped to and from rich domain entities inside each
// bounded context's infrastructure layer, so the domain never depends on Prisma.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Sample bounded context: Clients (care recipients).
model Client {
  id        String       @id @default(uuid()) @db.Uuid
  firstName String       @db.VarChar(100)
  lastName  String       @db.VarChar(100)
  email     String       @unique @db.VarChar(255)
  phone     String       @db.VarChar(32)
  status    ClientStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status])
  @@map("clients")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("client_status")
}

// Bounded context: Identity (mobile users, authentication).
//
// A user is a caregiver or a family member. Family owners self register on the
// mobile app; caregivers are onboarded later. Credentials, one time codes and
// refresh tokens are always stored hashed, never in clear.
model User {
  id            String     @id @default(uuid()) @db.Uuid
  userType      UserType
  firstName     String     @db.VarChar(100)
  lastName      String     @db.VarChar(100)
  email         String     @unique @db.VarChar(255)
  phone         String     @unique @db.VarChar(20)
  addressLine1  String     @db.VarChar(200)
  addressLine2  String?    @db.VarChar(200)
  city          String     @db.VarChar(120)
  state         String     @db.VarChar(120)
  postalCode    String     @db.VarChar(20)
  country       Country
  // Optional personal details surfaced on the profile; not captured at
  // registration, so nullable until the owner fills them in.
  dateOfBirth            DateTime? @db.Date
  relationshipToRecipient String?  @db.VarChar(120)
  passwordHash  String     @db.VarChar(255)
  emailVerified Boolean    @default(false)
  phoneVerified Boolean    @default(false)
  // Opaque storage key for the user's profile photo (upload deferred, key only).
  photoKey      String?    @db.VarChar(500)
  isFamilyOwner Boolean    @default(false)
  // True for an account provisioned with a temporary password (for example a
  // caregiver onboarded by an admin). Login still succeeds but signals the client
  // to force a password change; any password change clears the flag.
  mustChangePassword Boolean @default(false)
  // Two factor authentication (TOTP). When enabled, login requires a valid
  // authenticator code after the password. The secret is stored encrypted at
  // rest (AES 256 GCM) and never leaves the application in the clear.
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String? @db.VarChar(255)
  // Account security preferences and the password age shown on the security screen.
  passwordChangedAt     DateTime @default(now())
  biometricEnabled      Boolean  @default(false)
  sessionTimeoutMinutes Int      @default(15)
  status        UserStatus @default(PENDING_VERIFICATION)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  verificationCodes  VerificationCode[]
  deviceSessions     DeviceSession[]
  loginEvents        LoginEvent[]
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]

  @@index([status])
  @@map("users")
}

// A single use backup code for two factor authentication. Only the hash is
// stored (the codes are high entropy, so a fast deterministic hash is used for
// indexed lookup). A code is consumed exactly once; a fresh set replaces the old
// one when two factor is re enabled.
model TwoFactorRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @db.VarChar(255)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([codeHash])
  @@map("two_factor_recovery_codes")
}

// One time passcode issued for email verification or password reset. The code
// itself is stored only as a hash; expiry, single use and attempt caps are
// enforced in the domain.
model VerificationCode {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    VerificationPurpose
  codeHash   String              @db.VarChar(255)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                 @default(0)
  createdAt  DateTime            @default(now())

  @@index([userId, purpose])
  @@map("verification_codes")
}

// Persisted refresh token (stored hashed) enabling rotation and revocation.
// A signed in device (a session). The rotating refresh token hash lives here and
// is rotated in place on every refresh, so the session keeps one identity for the
// life of the device. Backs the Trusted Devices screen and "log out everywhere".
model DeviceSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceLabel      String    @db.VarChar(120)
  ipAddress        String?   @db.VarChar(64)
  userAgent        String?   @db.VarChar(400)
  currentTokenHash String?   @unique @db.VarChar(255)
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime
  revokedAt        DateTime?

  @@index([userId])
  @@map("device_sessions")
}

// An attributable login attempt (success or failure) for a known account. Feeds
// the Login Activity screen; only attempts tied to a user are recorded.
model LoginEvent {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcome     LoginOutcome
  deviceLabel String?      @db.VarChar(120)
  ipAddress   String?      @db.VarChar(64)
  userAgent   String?      @db.VarChar(400)
  createdAt   DateTime     @default(now())

  @@index([userId, createdAt])
  @@map("login_events")
}

enum LoginOutcome {
  SUCCESS
  FAILURE

  @@map("login_outcome")
}

enum UserType {
  CAREGIVER
  FAMILY_MEMBER

  @@map("user_type")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED

  @@map("user_status")
}

enum Country {
  US
  NG

  @@map("country")
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("verification_purpose")
}

// Bounded context: Care recipients (the "loved one" a family owner onboards).
//
// A family owner creates a digital identity for each member receiving care
// through a multi step wizard. The record is created as a DRAFT holding the
// identity profile, then progressively enriched with care needs, health and
// medication information and a care schedule before being finalised (ACTIVE).
//
// `ownerId` references the identity User aggregate by id only. Aggregates in
// different bounded contexts are linked by identifier without a database foreign
// key, so each context owns its own consistency boundary. Health and medication
// data is sensitive personal data and is never logged.
model CareRecipient {
  id      String              @id @default(uuid()) @db.Uuid
  ownerId String              @db.Uuid
  status  CareRecipientStatus @default(DRAFT)

  // Resume pointer: the wizard step to send the owner back to if they leave and
  // return mid onboarding.
  onboardingStep OnboardingStep @default(CARE_NEEDS)

  // Step 1: identity profile (always present from draft creation).
  name            String   @db.VarChar(200)
  gender          Gender
  dateOfBirth     DateTime @db.Date
  city            String   @db.VarChar(120)
  state           String   @db.VarChar(120)
  fullAddress     String   @db.VarChar(300)
  relationship    String   @db.VarChar(120)
  livingSituation String   @db.VarChar(120)
  photoKey        String?  @db.VarChar(500)

  // Pinned location of the address, captured at onboarding. Required before a
  // caregiver can clock in, since the arrival geofence is computed against it.
  latitude  Float?
  longitude Float?

  // Step 2: care needs (empty until the step is completed).
  careNeeds CareNeed[] @default([])

  // Step 3: health and medication information (null until the step is completed).
  // Free text conditions and allergies stay on the row; the medication schedule is
  // a structured child collection so a caregiver can record what was done with each
  // dose during a visit (see MedicationAdministration in the visits context).
  medicalConditions  String[] @default([])
  allergies          String[] @default([])
  needsMedicationHelp Boolean?
  medications        Medication[]

  // Care goals are set by the office (for example Maintain independence, Fall
  // prevention), not by the family owner. Surfaced read only on the family care
  // plan; the office capture surface is deferred to the admin module.
  careGoals CareGoal[]
  scheduleBlocks   CarePlanScheduleBlock[]
  careInstructions CareInstruction[]
  planRevisions    CarePlanRevision[]

  // Office set medication clinical warnings (drug interactions, food
  // instructions) and the append only prescription audit trail, surfaced on the
  // admin Medications screen.
  medicationWarnings MedicationWarning[]
  medicationAudits   MedicationAudit[]

  // The recipient's health event timeline (vitals summaries, alerts, incidents,
  // assessments, appointments), surfaced on the admin Health screen.
  healthEvents HealthEvent[]

  // The recipient's caregiver team (with roles), the append only assignment
  // history, and the recurring weekly coverage grid, surfaced on the admin
  // Caregivers screen.
  careTeam         CareTeamAssignment[]
  careTeamHistory  CareTeamAssignmentEvent[]
  coverageBlocks   CoverageBlock[]

  // The recipient's document registry, surfaced on the admin Documents screen.
  documents RecipientDocument[]

  // The recipient's billing: invoices, payments and the billing/insurance profile,
  // surfaced on the admin Billing screen.
  recipientInvoices        RecipientInvoice[]
  recipientInvoicePayments RecipientInvoicePayment[]
  billingProfile           BillingProfile?

  // The recipient's care notes activity log (visit notes, clinical observations,
  // coordinator entries, family communications and incidents), surfaced on the
  // admin Notes screen.
  careNotes CareNote[]

  // The recipient's registered family contacts and the logged interactions with
  // them, surfaced on the admin Family screen.
  familyContacts       FamilyContact[]
  familyCommunications FamilyCommunication[]

  // The recipient's archive/discharge record (one per recipient), surfaced on the
  // admin Archive/Discharge screen.
  dischargeRecord DischargeRecord?

  // Step 4: care schedule (null until the step is completed). The recurring
  // pattern (which weekdays, the start time in minutes from midnight, and how
  // long each visit lasts in minutes) is optional and may be refined after
  // onboarding by the family owner.
  careFrequency     CareFrequency?
  estimatedStartDate DateTime?     @db.Date
  expectedDuration  String?        @db.VarChar(120)
  careDays          Weekday[]      @default([])
  careStartMinute   Int?
  careVisitDurationMinutes Int?

  // Human friendly sequential number, rendered as CR-001 on the admin list and
  // searchable by ID. Database assigned; never surfaced into the domain aggregate.
  recipientNumber Int @unique @default(autoincrement())

  // Office set fields surfaced on the admin Care Recipients screen: a clinical
  // priority and the assigned primary caregiver (references the caregiver User by
  // id across contexts, no database foreign key).
  priority           CareRecipientPriority @default(NORMAL)
  primaryCaregiverId String?               @db.Uuid

  completedAt  DateTime?
  dischargedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([ownerId])
  @@index([ownerId, status])
  @@index([status, priority])
  @@map("care_recipients")
}

// One prescribed medication on a care recipient's schedule. Structured so the
// caregiver can see the name, dose and time of day and record administration
// against a specific entry. `scheduleMinute` is minutes from midnight (timezone
// free), null when the family did not pin a time. Owned by the CareRecipient
// aggregate and replaced wholesale when the health step is saved.
model Medication {
  id              String        @id @default(uuid()) @db.Uuid
  careRecipientId String        @db.Uuid
  name            String        @db.VarChar(200)
  dose            String?       @db.VarChar(60)
  scheduleMinute  Int?
  // Office set prescription fields (null when only the family onboarding captured
  // the medication). `doseTimes` are the times of day a dose is due, minutes from
  // midnight, ordered; it drives the daily dose schedule. `status` lets the office
  // discontinue a prescription without deleting it, so history is preserved.
  purpose         String?          @db.VarChar(300)
  prescribedBy    String?          @db.VarChar(120)
  startDate       DateTime?        @db.Date
  instructions    String?          @db.VarChar(300)
  doseTimes       Int[]            @default([])
  status          MedicationStatus @default(ACTIVE)
  discontinuedAt  DateTime?
  position        Int
  createdAt       DateTime      @default(now())

  careRecipient CareRecipient @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)

  @@index([careRecipientId])
  @@map("medications")
}

// One office set goal for a care recipient's plan (for example Maintain
// independence). Owned by the recipient and surfaced read only on the family
// care plan; ordered by position. The office capture path is deferred.
model CareGoal {
  id              String         @id @default(uuid()) @db.Uuid
  careRecipientId String         @db.Uuid
  label           String         @db.VarChar(200)
  achieved        Boolean        @default(false)
  progressPercent Int            @default(0)
  status          CareGoalStatus @default(ON_TRACK)
  position        Int
  createdAt       DateTime       @default(now())

  careRecipient CareRecipient @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)

  @@index([careRecipientId])
  @@map("care_goals")
}

// One block of a care recipient's daily care schedule (time, title, description).
// Office set and replaced wholesale when the schedule is edited.
model CarePlanScheduleBlock {
  id              String   @id @default(uuid()) @db.Uuid
  careRecipientId String   @db.Uuid
  startMinute     Int
  title           String   @db.VarChar(200)
  description     String   @db.VarChar(500)
  position        Int
  createdAt       DateTime @default(now())

  careRecipient CareRecipient @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)

  @@index([careRecipientId])
  @@map("care_plan_schedule_blocks")
}

// One care instruction: a medical need or a behavioral note/protocol, with a
// severity. Office set and replaced wholesale when the instructions are edited.
model CareInstruction {
  id              String                  @id @default(uuid()) @db.Uuid
  careRecipientId String                  @db.Uuid
  category        CareInstructionCategory
  text            String                  @db.VarChar(300)
  severity        CareInstructionSeverity @default(NORMAL)
  position        Int
  createdAt       DateTime                @default(now())

  careRecipient CareRecipient @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)

  @@index([careRecipientId])
  @@map("care_instructions")
}

// One append only entry in a care plan's revision history, attributed to the
// admin who made the change.
model CarePlanRevision {
  id              String   @id @default(uuid()) @db.Uuid
  careRecipientId String   @db.Uuid
  description     String   @db.VarChar(300)
  authorAdminId   String?  @db.Uuid
  createdAt       DateTime @default(now())

  careRecipient CareRecipient @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)

  @@index([careRecipientId, createdAt])
  @@map("care_plan_revisions")
}

// One office set medication clinical warning for a recipient (a drug interaction
// or a food instruction). Free text authored by the office; replaced wholesale
// when the clinical warning profile is edited. Ordered by position.
model MedicationWarning {
  id              String   @id @default(uuid()) @db.Uuid
  careRecipientId String   @db.Uuid
  title           String   @db.VarChar(200)
  detail          String   @db.VarChar(1000)
  position        Int
  createdAt       DateTime @default(now())

  careRecipient CareRecipient @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)

  @@index([careRecipientId])
  @@map("medication_warnings")
}

// One append only entry in a recipient's prescription history and audit trail
// (for example "Donepezil increased 5mg to 10mg"), attributed to the admin who
// recorded it. Written whenever a prescription is added, edited or discontinued.
model MedicationAudit {
  id              String   @id @default(uuid()) @db.Uuid
  careRecipientId String   @db.Uuid
  title           String   @db.VarChar(200)
  detail          String   @db.VarChar(1000)
  authorAdminId   String?  @db.Uuid
  createdAt       DateTime @default(now())

  careRecipient CareRecipient @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)

  @@index([careRecipientId, createdAt])
  @@map("medication_audits")
}

enum MedicationStatus {
  ACTIVE
  DISCONTINUED

  @@map("medication_status")
}

// One entry in a recipient's health event timeline. The office (or a caregiver,
// doctor, coordinator or specialist, captured as free text) records a vitals
// summary, an alert, a medication change, an incident, an assessment, an
// appointment or a care note. `occurredAt` may be in the future for a scheduled
// appointment. Attributed to the admin who entered it. Sensitive clinical data,
// never logged.
model HealthEvent {
  id              String              @id @default(uuid()) @db.Uuid
  careRecipientId String              @db.Uuid
  category        HealthEventCategory
  title           String              @db.VarChar(200)
  description     String              @db.VarChar(2000)
  // Who observed or reported the event (free text, e.g. "Sarah Williams") and
  // their role (e.g. "Caregiver", "Geriatrician"). Distinct from the admin author.
  recordedByName  String?             @db.VarChar(120)
  recordedByRole  String?             @db.VarChar(120)
  occurredAt      DateTime
  authorAdminId   String?             @db.Uuid
  createdAt       DateTime            @default(now())

  careRecipient CareRecipient @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)

  @@index([careRecipientId, occurredAt])
  @@map("health_events")
}

enum HealthEventCategory {
  VITALS
  ALERT
  MEDICATION
  INCIDENT
  ASSESSMENT
  APPOINTMENT
  SPECIALIST
  CARE

  @@map("health_event_category")
}

// One caregiver's membership on a recipient's care team, in a role, with an office
// set specialization and working schedule. Removed (removedAt stamped) rather than
// deleted, so the assignment history is preserved.
model CareTeamAssignment {
  id              String       @id @default(uuid()) @db.Uuid
  careRecipientId String       @db.Uuid
  // References the caregiver User by id across contexts (no database foreign key).
  caregiverId     String       @db.Uuid
  role            CareTeamRole
  specialization  String?      @db.VarChar(200)
  scheduleLabel   String?      @db.VarChar(200)
  assignedAt      DateTime
  removedAt       DateTime?
  createdAt       DateTime     @default(now())

  careRecipient CareRecipient @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)

  @@index([careRecipientId])
  @@map("care_team_assignments")
}

// One append only entry in a recipient's caregiver assignment history (a caregiver
// assigned to or removed from the team, with the reason), attributed to the admin.
model CareTeamAssignmentEvent {
  id              String         @id @default(uuid()) @db.Uuid
  careRecipientId String         @db.Uuid
  caregiverId     String         @db.Uuid
  action          CareTeamAction
  reason          String         @db.VarChar(500)
  byAdminId       String?        @db.Uuid
  createdAt       DateTime       @default(now())

  careRecipient CareRecipient @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)

  @@index([careRecipientId, createdAt])
  @@map("care_team_assignment_events")
}

// One block of a recipient's recurring weekly coverage grid: a weekday and slot
// (morning or afternoon) covered by a caregiver, or open. Office set and replaced
// wholesale when the coverage template is edited.
model CoverageBlock {
  id              String       @id @default(uuid()) @db.Uuid
  careRecipientId String       @db.Uuid
  weekday         Weekday
  slot            CoverageSlot
  caregiverId     String?      @db.Uuid
  createdAt       DateTime     @default(now())

  careRecipient CareRecipient @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)

  @@index([careRecipientId])
  @@map("coverage_blocks")
}

enum CareTeamRole {
  PRIMARY
  BACKUP
  COORDINATOR

  @@map("care_team_role")
}

enum CareTeamAction {
  ASSIGNED
  REMOVED

  @@map("care_team_action")
}

enum CoverageSlot {
  MORNING
  AFTERNOON

  @@map("coverage_slot")
}

// One document held for a care recipient. Stores metadata and an opaque storage
// key; the file lives in object storage (upload and download deferred). `expiresAt`
// drives the derived Expiring Soon status for documents that lapse.
model RecipientDocument {
  id              String           @id @default(uuid()) @db.Uuid
  careRecipientId String           @db.Uuid
  name            String           @db.VarChar(300)
  category        DocumentCategory
  storageKey      String           @db.VarChar(500)
  sizeBytes       Int
  uploadedByName  String?          @db.VarChar(120)
  status          DocumentStatus   @default(CURRENT)
  expiresAt       DateTime?
  uploadedAt      DateTime
  updatedAt       DateTime         @updatedAt

  careRecipient CareRecipient @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)

  @@index([careRecipientId, uploadedAt])
  @@index([careRecipientId, category])
  @@map("recipient_documents")
}

enum DocumentCategory {
  MEDICAL_RECORDS
  CARE_PLANS
  LEGAL
  INSURANCE
  CERTIFICATIONS
  PHOTOS

  @@map("document_category")
}

enum DocumentStatus {
  CURRENT
  PENDING_REVIEW
  VERIFIED

  @@map("document_status")
}

// An office issued invoice for a recipient over a billing period. The amount is the
// sum of its lines; insurance covers part and the remainder is the patient due.
// Money is integer minor units in the owner's billing currency. `sequence` is a
// database assigned number formatted as INV-YYYY-NNN for display.
model RecipientInvoice {
  id                    String                 @id @default(uuid()) @db.Uuid
  careRecipientId       String                 @db.Uuid
  sequence              Int                    @unique @default(autoincrement())
  periodStart           DateTime               @db.Date
  periodEnd             DateTime               @db.Date
  servicesLabel         String                 @db.VarChar(300)
  currency              Currency
  // Denormalised total (the sum of the line amounts), stored so the read model can
  // aggregate billed and outstanding figures without re-summing lines per invoice.
  amountMinor           Int
  insuranceCoveredMinor Int
  status                RecipientInvoiceStatus @default(PENDING)
  issuedAt              DateTime
  dueDate               DateTime?              @db.Date
  createdAt             DateTime               @default(now())

  careRecipient CareRecipient          @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)
  lines         RecipientInvoiceLine[]

  @@index([careRecipientId, issuedAt])
  @@map("recipient_invoices")
}

// One service line on a recipient invoice (service name and amount in minor units).
// Drives the invoice total and the year to date service breakdown.
model RecipientInvoiceLine {
  id          String @id @default(uuid()) @db.Uuid
  invoiceId   String @db.Uuid
  serviceName String @db.VarChar(120)
  amountMinor Int
  position    Int

  invoice RecipientInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("recipient_invoice_lines")
}

// A payment received towards a recipient's invoices (patient or insurance). Only a
// display safe method label is stored, never card data.
model RecipientInvoicePayment {
  id              String   @id @default(uuid()) @db.Uuid
  careRecipientId String   @db.Uuid
  invoiceId       String?  @db.Uuid
  amountMinor     Int
  currency        Currency
  methodLabel     String?  @db.VarChar(120)
  receivedAt      DateTime
  createdAt       DateTime @default(now())

  careRecipient CareRecipient @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)

  @@index([careRecipientId, receivedAt])
  @@map("recipient_invoice_payments")
}

// The office set billing and insurance profile for a recipient (one per recipient).
// Only display safe payment details (brand and last four) are stored.
model BillingProfile {
  id                              String    @id @default(uuid()) @db.Uuid
  careRecipientId                 String    @unique @db.Uuid
  billingContactName              String?   @db.VarChar(200)
  billingContactRelationship      String?   @db.VarChar(200)
  billingContactEmail             String?   @db.VarChar(200)
  billingContactPhone             String?   @db.VarChar(200)
  paymentMethodBrand              String?   @db.VarChar(200)
  paymentMethodLast4              String?   @db.VarChar(4)
  autoPayEnabled                  Boolean   @default(false)
  primaryInsuranceProvider        String?   @db.VarChar(200)
  primaryInsurancePolicyNumber    String?   @db.VarChar(200)
  primaryInsuranceCoveragePercent Int?
  primaryInsuranceCoverageDetails String?   @db.VarChar(500)
  coPayPerVisitMinor              Int?
  coPayCurrency                   Currency?
  secondaryInsurance              String?   @db.VarChar(500)
  updatedAt                       DateTime  @updatedAt

  careRecipient CareRecipient @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)

  @@map("billing_profiles")
}

enum RecipientInvoiceStatus {
  PENDING
  PAID

  @@map("recipient_invoice_status")
}

// One care note on a recipient's activity log: a caregiver visit note, a clinical
// observation, a coordinator entry, a family communication or an incident report.
// Authored by whoever logged it (free text name and role); an office coordinator may
// add one too. Flagging marks a note for urgent supervisor attention; acknowledging
// records that a supervisor reviewed it. Sensitive personal data; never logged.
model CareNote {
  id                    String       @id @default(uuid()) @db.Uuid
  careRecipientId       String       @db.Uuid
  category              NoteCategory
  content               String       @db.VarChar(4000)
  // Who wrote the note (free text, e.g. "Sarah Williams") and their role (e.g.
  // "CNA", "Care Coordinator", "Family"). Distinct from the admin attribution.
  authorName            String       @db.VarChar(120)
  authorRole            String?      @db.VarChar(120)
  // Opaque object store references for attachments; storage and download deferred.
  attachmentKeys        String[]     @default([])
  flaggedForReview      Boolean      @default(false)
  acknowledgedAt        DateTime?
  acknowledgedByAdminId String?      @db.Uuid
  // The admin who entered the note, for attribution. Null for app authored notes.
  authorAdminId         String?      @db.Uuid
  postedAt              DateTime
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  careRecipient CareRecipient @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)
  comments      NoteComment[]

  @@index([careRecipientId, postedAt])
  @@index([careRecipientId, category])
  @@map("care_notes")
}

// One comment appended to a care note (a supervisor or colleague reply). Append only;
// feeds the comment count on the note card.
model NoteComment {
  id         String   @id @default(uuid()) @db.Uuid
  noteId     String   @db.Uuid
  authorName String   @db.VarChar(120)
  authorRole String?  @db.VarChar(120)
  content    String   @db.VarChar(2000)
  createdAt  DateTime @default(now())

  note CareNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
  @@map("note_comments")
}

enum NoteCategory {
  VISIT_NOTE
  CLINICAL
  COORDINATOR
  FAMILY_COMMUNICATION
  INCIDENT

  @@map("note_category")
}

// One family member registered against a care recipient, authorised to receive
// updates, participate in scheduling or manage care. Holds contact details, one or
// more designated roles, a portal access level and a preferred contact channel.
