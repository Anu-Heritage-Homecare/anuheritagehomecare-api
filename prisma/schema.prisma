model FamilyContact {
  id                      String                        @id @default(uuid()) @db.Uuid
  careRecipientId         String                        @db.Uuid
  name                    String                        @db.VarChar(200)
  relationship            String                        @db.VarChar(120)
  roles                   FamilyContactRole[]           @default([])
  roleNote                String?                       @db.VarChar(200)
  phone                   String?                       @db.VarChar(200)
  email                   String?                       @db.VarChar(200)
  address                 String?                       @db.VarChar(500)
  accessLevel             FamilyAccessLevel             @default(VIEW_ONLY)
  accessScopeLabel        String?                       @db.VarChar(200)
  authorizedSectionsLabel String?                       @db.VarChar(500)
  preferredMethod         FamilyPreferredContactMethod?
  portalLoginEnabled      Boolean                       @default(false)
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt

  careRecipient  CareRecipient         @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)
  communications FamilyCommunication[]

  @@index([careRecipientId])
  @@map("family_contacts")
