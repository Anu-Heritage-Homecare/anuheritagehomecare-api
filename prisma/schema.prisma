  staffMemberName String                  @db.VarChar(120)
  occurredAt      DateTime
  createdAt       DateTime                @default(now())

  careRecipient CareRecipient @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)
  familyContact FamilyContact @relation(fields: [familyContactId], references: [id], onDelete: Cascade)

  @@index([careRecipientId, occurredAt])
  @@index([familyContactId, occurredAt])
  @@map("family_communications")
}

enum FamilyContactRole {
  PRIMARY_CONTACT
  SECONDARY_CONTACT
  EMERGENCY_CONTACT
  POWER_OF_ATTORNEY
  BILLING_CONTACT
  MEDICAL_DECISION_BACKUP
  VISIT_COMPANION

  @@map("family_contact_role")
}

enum FamilyAccessLevel {
