// Bounded context: Care plans (the catalog the family owner chooses from).
//
// Reference data: the four plans, how each is billed, the hour options for the
// hourly plan, and the price in each supported currency. Money is stored as an
// integer number of minor units (cents, kobo) to avoid floating point rounding.
model CarePlan {
  id           String       @id @default(uuid()) @db.Uuid
  type         CarePlanType @unique
  name         String       @db.VarChar(120)
  description  String       @db.VarChar(300)
  billingModel BillingModel
  allowedHours Int[]        @default([])
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  prices CarePlanPrice[]

  @@map("care_plans")
}

// The price of a plan in one currency. `unitAmountMinor` is the hourly rate for
// an hourly plan or the monthly price for a monthly plan.
model CarePlanPrice {
  id              String   @id @default(uuid()) @db.Uuid
  planId          String   @db.Uuid
  plan            CarePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  currency        Currency
  unitAmountMinor Int
  serviceFeeMinor Int      @default(0)

  // Recurring billing references at the provider for monthly plans: a Stripe
  // recurring Price id (USD) and a Paystack plan code (NGN).
  stripePriceId    String? @db.VarChar(200)
  paystackPlanCode String? @db.VarChar(200)

  @@unique([planId, currency])
  @@map("care_plan_prices")
}

// Bounded context: Bookings (a one time hourly booking for the Flexible plan).
//
// Pricing is snapshotted at creation so later catalog changes never rewrite past
// orders. `ownerId` and `careRecipientId` reference other contexts by id only.
model Booking {
  id              String       @id @default(uuid()) @db.Uuid
  ownerId         String       @db.Uuid
  careRecipientId String       @db.Uuid
  planType        CarePlanType
  hours           Int
  serviceDate     DateTime     @db.Date
  startMinute     Int
  endMinute       Int
  currency        Currency
  hourlyRateMinor Int
  subtotalMinor   Int
  serviceFeeMinor Int
  totalMinor      Int
  status          BookingStatus @default(PENDING_PAYMENT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([ownerId])
  @@index([careRecipientId])
  @@map("bookings")
}

// A scheduled care session assigning a caregiver to a care recipient on a given
// day and time window. How visits are created and assigned (from bookings and
// subscriptions, or by an admin) is not built yet; this models the execution
// record the caregiver schedule reads. Recipient facing detail (name, health,
// address) is not duplicated here; it is read from the care recipients context.
model Visit {
  id                  String      @id @default(uuid()) @db.Uuid
  // Null while the visit is unassigned (planned by the office but no caregiver
  // yet). An admin assigns a caregiver, which stamps assignedAt.
  caregiverId         String?     @db.Uuid
  assignedAt          DateTime?
  careRecipientId     String      @db.Uuid
  scheduledDate       DateTime    @db.Date
  startMinute         Int
  endMinute           Int
  visitType           VisitType     @default(PERSONAL_CARE)
  priority            VisitPriority @default(NORMAL)
  status              VisitStatus @default(SCHEDULED)
  specialInstructions String[]
  // Attendance, stamped server side when the caregiver clocks in and out. The
  // arrival coordinates record where the geofenced clock in was accepted.
  clockInAt         DateTime?
  clockOutAt        DateTime?
  arrivalLatitude   Float?
  arrivalLongitude  Float?
  // Photos the caregiver attached during the visit. Opaque storage references
  // (the upload endpoint is deferred). The notes feed lives in the VisitNote model.
  photoKeys  String[] @default([])
  // The caregiver's qualitative observations for the visit (mood, appetite,
  // mobility, whether medication was taken). Short free text, health related.
  observationMood       String? @db.VarChar(120)
  observationAppetite   String? @db.VarChar(120)
  observationMobility   String? @db.VarChar(120)
  observationMedication String? @db.VarChar(120)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  tasks                    VisitTask[]
  medicationAdministrations MedicationAdministration[]
  vitals                   VisitVitals[]
  breaks                   VisitBreak[]
  notes                    VisitNote[]

  @@index([caregiverId, scheduledDate])
  @@index([careRecipientId])
  @@map("visits")
}

// Who a visit note is written for: the internal care team, or the family.
enum NoteAudience {
  CARE_TEAM
  FAMILY

  @@map("note_audience")
}

// A single note a caregiver writes on a visit, part of an append only feed. The
// author is a user id (resolved to a name and role by the reading side); the text
// is sensitive free text about the recipient and is kept out of logs.
model VisitNote {
  id        String       @id @default(uuid()) @db.Uuid
  visitId   String       @db.Uuid
  authorId  String       @db.Uuid
  audience  NoteAudience @default(FAMILY)
  text      String       @db.VarChar(4000)
  createdAt DateTime     @default(now())

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId, createdAt])
  @@map("visit_notes")
}

// A break a caregiver takes during a visit. Append only interval: `startedAt` is
// stamped when the break begins and `endedAt` when it ends (null while the break
// is open). Total break time is the sum of the closed intervals, and an open
// interval means the visit is ON_BREAK. Owned by the Visit aggregate.
model VisitBreak {
  id        String    @id @default(uuid()) @db.Uuid
  visitId   String    @db.Uuid
  startedAt DateTime
  endedAt   DateTime?

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("visit_breaks")
}

// What the caregiver did with one scheduled medication during a visit: either it
// was administered or it was not, with a reason. `medicationId` references a
// Medication in the care recipients context by id only (no cross context foreign
// key). One record per medication per visit. Owned by the Visit aggregate.
model MedicationAdministration {
  id           String                         @id @default(uuid()) @db.Uuid
  visitId      String                         @db.Uuid
  medicationId String                         @db.Uuid
  outcome      MedicationAdministrationOutcome
  note         String?                        @db.VarChar(500)
  recordedAt   DateTime

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([visitId, medicationId])
  @@index([visitId])
  @@map("medication_administrations")
}

// A set of vital signs a caregiver recorded during a visit. Append only: each
// submission is a new reading stamped server side, so the history is preserved.
// Every measure is optional; at least one is present. Weight is stored in whole
// grams to avoid floating point. Owned by the Visit aggregate.
model VisitVitals {
  id                String   @id @default(uuid()) @db.Uuid
  visitId           String   @db.Uuid
  systolic          Int?
  diastolic         Int?
  heartRate         Int?
  oxygenSaturation  Int?
  weightGrams       Int?
  // Body temperature in whole tenths of a degree Celsius (36.8 C = 368).
  temperatureTenths Int?
  // Blood glucose in mg/dL.
  bloodGlucose      Int?
  recordedAt        DateTime

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("visit_vitals")
}

enum MedicationAdministrationOutcome {
  ADMINISTERED
  REFUSED
  OUT_OF_STOCK
  PATIENT_ASLEEP

  @@map("medication_administration_outcome")
}

// An emergency alert a caregiver raises from an active shift (the SOS button).
// High signal: stored with the caregiver's current position and a snapshot of the
// care recipient's details (name, address, pinned location) so a responder can act
// without a live join. The caregiver can cancel an alert they raised in error.
// Coordinates, the recipient name and the address are sensitive and kept out of
// the logs. `visitId` and `careRecipientId` reference other rows by id only.
model SosAlert {
  id          String         @id @default(uuid()) @db.Uuid
  caregiverId String         @db.Uuid
  visitId     String         @db.Uuid
  latitude    Float?
  longitude   Float?
  // Snapshot of the care recipient at the moment the alert was raised.
  careRecipientId   String  @db.Uuid
  recipientName     String? @db.VarChar(200)
  recipientAddress  String? @db.VarChar(300)
  recipientLatitude  Float?
  recipientLongitude Float?
  status      SosAlertStatus @default(ACTIVE)
  cancelledAt DateTime?
  createdAt   DateTime       @default(now())

  @@index([caregiverId, createdAt])
  @@index([visitId])
  @@map("sos_alerts")
}

enum SosAlertStatus {
  ACTIVE
  CANCELLED

  @@map("sos_alert_status")
}

// A single task on a visit checklist (for example Blood Pressure, Meal
// Preparation). Owned by the Visit aggregate and replaced wholesale on save.
model VisitTask {
  id          String    @id @default(uuid()) @db.Uuid
  visitId     String    @db.Uuid
  label       String    @db.VarChar(200)
  completed   Boolean   @default(false)
  // When the task was ticked off, so the activity feed can place it on a
  // timeline. Null while the task is not complete.
  completedAt DateTime?
  // How long the task took, in whole minutes. Optional, only set when completed.
  durationMinutes Int?
  position    Int

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("visit_tasks")
}

// A recurring monthly subscription for the Standard, Premium or Live in plans.
model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  ownerId           String             @db.Uuid
  careRecipientId   String             @db.Uuid
  planType          CarePlanType
  startDate         DateTime           @db.Date
  currency          Currency
  monthlyPriceMinor Int
  status            SubscriptionStatus @default(PENDING_PAYMENT)
  // Whether the subscription renews automatically at the end of each cycle.
  autoRenew         Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([ownerId])
  @@index([careRecipientId])
  @@index([status])
  @@map("subscriptions")
}

enum Currency {
  USD
  NGN

  @@map("currency")
}

// The family owner's emergency contact (Profile). One row per user; distinct from
// the owner's own account details so a different person can be reached in an
// emergency. Owned by the profile context.
model EmergencyContact {
  userId       String   @id @db.Uuid
  name         String   @db.VarChar(200)
  phone        String   @db.VarChar(20)
  relationship String   @db.VarChar(120)
  updatedAt    DateTime @updatedAt

  @@map("emergency_contacts")
}

// One member of a family owner's care circle: an app user granted access to the
// owner's care information at a level. Name and avatar come from the linked user
