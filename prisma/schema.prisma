}

// A single location breadcrumb reported by a caregiver's device. Append only and
// high volume: written in batches and read later for the admin movement audit
// (path replay, travel time, long stops). Sent frequently during navigation and
// occasionally in the background, distinguished by `mode`. `visitId` is an
// optional tag; it is not a foreign key so telemetry never blocks on a visit row.
model LocationPing {
  id             String       @id @default(uuid()) @db.Uuid
  caregiverId    String       @db.Uuid
  visitId        String?      @db.Uuid
  // Set on points streamed at high frequency while an SOS alert is active, so the
  // emergency path can be replayed. A tag only; not a foreign key.
  sosAlertId     String?      @db.Uuid
  latitude       Float
  longitude      Float
  accuracyMeters Float?
  mode           LocationMode
  recordedAt     DateTime
  receivedAt     DateTime     @default(now())

  @@index([caregiverId, recordedAt])
  @@index([visitId])
  @@index([sosAlertId])
  @@map("location_pings")
}

enum LocationMode {
  NAVIGATION
  BACKGROUND
  EMERGENCY

  @@map("location_mode")
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAUSED
  PAST_DUE
  CANCELLED

  @@map("subscription_status")
}

// Bounded context: Payments.
//
// A payment charges for a booking or a subscription through a provider chosen by
// the owner's currency (Stripe for USD, Paystack for NGN). The provider is the
// source of truth for the outcome, confirmed through verification and webhooks.
model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  ownerId           String          @db.Uuid
  payableType       PayableType
  payableId         String          @db.Uuid
  provider          PaymentProvider
  providerReference String          @unique @db.VarChar(200)
  currency          Currency
  amountMinor       Int
  status            PaymentStatus   @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([ownerId])
  @@index([payableType, payableId])
  @@map("payments")
}

// A saved card, tokenised by the provider. The raw card is never stored; only an
// opaque provider reference plus display metadata (brand, last four).
model PaymentMethod {
  id                  String          @id @default(uuid()) @db.Uuid
  ownerId             String          @db.Uuid
  provider            PaymentProvider
  providerCustomerRef String?         @db.VarChar(200)
  providerMethodRef   String          @db.VarChar(200)
  brand               String          @db.VarChar(40)
  last4               String          @db.VarChar(4)
  expMonth            Int
  expYear             Int
  cardHolderName      String?         @db.VarChar(200)
  isDefault           Boolean         @default(false)
  createdAt           DateTime        @default(now())

  @@unique([provider, providerMethodRef])
  @@index([ownerId])
  @@map("payment_methods")
}

enum PaymentProvider {
  STRIPE
  PAYSTACK

  @@map("payment_provider")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED

  @@map("payment_status")
}

enum PayableType {
  BOOKING
  SUBSCRIPTION
  INVOICE

  @@map("payable_type")
}

// Bounded context: Earnings.
//
// The pay rate and rules for one caregiver, used to estimate their earnings for
// the current pay period from the visits they worked. Money is stored as integer
// minor units and rates as basis points to keep the arithmetic free of floating
// point. Values are placeholders until real figures are set; a caregiver without
// a row simply estimates to zero. One row per caregiver.
model CaregiverPayRate {
  id                    String   @id @default(uuid()) @db.Uuid
  caregiverId           String   @unique @db.Uuid
  currency              Currency
  hourlyRateMinor       Int
  // Overtime multiplier in basis points of the hourly rate (15000 = 1.5x).
  overtimeMultiplierBps Int      @default(15000)
  // Regular hours in a pay period before overtime applies.
  regularHoursCap       Int      @default(80)
  // Flat bonus in minor units for each visit worked on a weekend.
  weekendBonusMinor     Int      @default(0)
  // Tax and deductions in basis points of gross pay (250 = 2.5%).
  taxRateBps            Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("caregiver_pay_rates")
}

// A finalized payslip: an immutable snapshot of a caregiver's pay for one closed
// pay period, written by the payroll run. Money is in integer minor units and
// time in whole minutes, matching the earnings calculator. One per caregiver per
// period.
model Payslip {
  id                String   @id @default(uuid()) @db.Uuid
  caregiverId       String   @db.Uuid
  currency          Currency
  periodStart       DateTime @db.Date
  periodEnd         DateTime @db.Date
  payDay            DateTime @db.Date
  workedMinutes     Int
  regularMinutes    Int
  regularPayMinor   Int
  overtimeMinutes   Int
  overtimePayMinor  Int
  weekendVisits     Int
  weekendBonusMinor Int
  grossMinor        Int
  deductionsMinor   Int
  netMinor          Int
  createdAt         DateTime @default(now())

  @@unique([caregiverId, periodStart])
  @@index([caregiverId, periodStart])
  @@map("payslips")
}

// Bounded context: availability (the time windows a caregiver declares they are
// open to work, one record per caregiver per day).
model CaregiverAvailability {
  id          String   @id @default(uuid()) @db.Uuid
  caregiverId String   @db.Uuid
  date        DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slots CaregiverAvailabilitySlot[]

  @@unique([caregiverId, date])
  @@index([caregiverId, date])
  @@map("caregiver_availability")
}

model CaregiverAvailabilitySlot {
  id             String @id @default(uuid()) @db.Uuid
  availabilityId String @db.Uuid
  // Minutes from midnight, timezone free, matching the visit window convention.
  startMinute    Int
  endMinute      Int

  availability CaregiverAvailability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)

  @@index([availabilityId])
  @@map("caregiver_availability_slots")
}

// Bounded context: care requests (a family owner asks for an extra care session).
enum CareRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED

  @@map("care_request_status")
}

model AdditionalCareRequest {
  id              String            @id @default(uuid()) @db.Uuid
  ownerId         String            @db.Uuid
  careRecipientId String            @db.Uuid
  careType        String            @db.VarChar(100)
  requestedDate   DateTime          @db.Date
  // Requested start time as minutes from midnight (timezone free), and duration.
  startMinute     Int
  durationMinutes Int
  reason          String?           @db.VarChar(1000)
  status          CareRequestStatus @default(PENDING)
  // Office decision audit: who actioned the request, when, and any decline note.
  actionedByAdminId String?         @db.Uuid
  actionedAt        DateTime?
  decisionNote      String?         @db.VarChar(1000)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([careRecipientId, createdAt])
  @@index([ownerId])
  @@index([status, createdAt])
  @@map("additional_care_requests")
}

// Bounded context: client onboarding (the admin Plans and Billing lifecycle
// funnel). An application is a family signing up a patient for a plan; it advances
// forward through the onboarding stages to an activated subscription. Each entry
// into a stage is recorded on ClientLifecycleEvent so the pipeline can report how
// long each stage takes and the average activation time end to end.
model ClientApplication {
  id                      String                  @id @default(uuid()) @db.Uuid
  // Human readable reference: rendered as CR-{year}-{sequence} on the queue.
  sequence                Int                     @unique @default(autoincrement())
  ownerId                 String?                 @db.Uuid
  careRecipientId         String?                 @db.Uuid
  familyName              String                  @db.VarChar(200)
  patientName             String                  @db.VarChar(200)
  selectedPlanType        CarePlanType?
  currency                Currency
  monthlyPriceMinor       Int?
  priority                OnboardingPriority      @default(MEDIUM)
  paymentStatus           OnboardingPaymentStatus @default(PENDING)
  docsStatus              DocsStatus              @default(MISSING)
  coordinatorId           String?                 @db.Uuid
  caregiverId             String?                 @db.Uuid
  stage                   OnboardingStage         @default(NEW_REQUEST)
  status                  OnboardingStatus        @default(PENDING)
  submittedAt             DateTime
  activatedSubscriptionId String?                 @db.Uuid
  // Intake snapshot: used on the detail panel when the application is not yet
  // linked to a CareRecipient or User (hybrid fallback), plus the request specific
  // schedule and special needs, which are not clinical facts about the patient.
  patientDateOfBirth    DateTime? @db.Date
  patientGender         String?   @db.VarChar(20)
  patientConditions     String[]  @default([])
  contactName           String?   @db.VarChar(200)
  contactPhone          String?   @db.VarChar(40)
  contactEmail          String?   @db.VarChar(255)
  contactAddress        String?   @db.VarChar(400)
  requestedHoursPerWeek Int?
  requestedSchedule     String?   @db.VarChar(300)
  specialNeeds          String?   @db.VarChar(1000)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  events    ClientLifecycleEvent[]
  documents ClientApplicationDocument[]

  @@index([stage])
  @@index([status])
  @@index([currency, createdAt])
  @@index([coordinatorId])
  @@index([priority])
  @@map("client_applications")
}

model ClientApplicationDocument {
  id            String            @id @default(uuid()) @db.Uuid
  applicationId String            @db.Uuid
  application   ClientApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  label         String            @db.VarChar(200)
  // Opaque storage key; actual document storage is deferred, key only for now.
  key           String            @db.VarChar(500)
  createdAt     DateTime          @default(now())

  @@index([applicationId])
  @@map("client_application_documents")
}

model ClientLifecycleEvent {
  id            String            @id @default(uuid()) @db.Uuid
  applicationId String            @db.Uuid
  application   ClientApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage         OnboardingStage
  enteredAt     DateTime
  createdAt     DateTime          @default(now())

  @@index([applicationId])
  @@index([stage, enteredAt])
  @@map("client_lifecycle_events")
}

enum OnboardingStage {
  NEW_REQUEST
  PLAN_SELECTED
  PAYMENT_RECEIVED
  PENDING_REVIEW
  DOC_VERIFIED
  COORDINATOR_ASSIGNED
  CAREGIVER_SCHEDULED
  SUB_ACTIVATED

  @@map("onboarding_stage")
}

enum OnboardingStatus {
  PENDING
  UNDER_REVIEW
  NEEDS_INFO
  APPROVED
  REJECTED

  @@map("onboarding_status")
}

enum OnboardingPaymentStatus {
  PENDING
  PAID
  FAILED

  @@map("onboarding_payment_status")
}

enum OnboardingPriority {
  HIGH
  MEDIUM
  LOW

  @@map("onboarding_priority")
}

enum DocsStatus {
  COMPLETE
  INCOMPLETE
  MISSING

  @@map("docs_status")
}

// Bounded context: admin care plan management (the Plans and Billing Care Plans
// screen). A managed plan carries the full editable configuration of a plan. A
// core plan links to one of the four canonical CarePlanType values that checkout
// uses (coreType, unique); a custom plan has no such link and is not wired into
// booking or checkout yet. Services and volume discounts are stored as JSON since
// they are always read and written as a whole with the plan; coverage areas and
// eligibility rules are string arrays; every revision appends a version row.
model ManagedCarePlan {
  id                    String            @id @default(uuid()) @db.Uuid
  coreType              CarePlanType?     @unique
  isCore                Boolean           @default(false)
  name                  String            @db.VarChar(120)
  description           String            @db.VarChar(500)
  targetAudience        String?           @db.VarChar(300)
  billingModel          BillingModel
  status                ManagedPlanStatus @default(ACTIVE)
  countriesEnabled      Country[]         @default([])
  supportedCurrencies   Currency[]        @default([])
  minimumBillingHours   Int?
  autoRenewal           Boolean           @default(true)
  billingCycle          BillingCycle      @default(MONTHLY)
  gracePeriodDays       Int               @default(7)
  cancellationNoticeDays Int              @default(30)
  services              Json              @default("[]")
  volumeDiscounts       Json              @default("[]")
  coverageAreas         String[]          @default([])
  eligibilityRules      String[]          @default([])
  currentVersion        Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  prices   ManagedCarePlanPrice[]
  versions ManagedCarePlanVersion[]

  @@index([status])
  @@map("managed_care_plans")
}

model ManagedCarePlanPrice {
  id                        String          @id @default(uuid()) @db.Uuid
  planId                    String          @db.Uuid
  plan                      ManagedCarePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  currency                  Currency
  monthlyPriceMinor         Int?
  baseRateMinor             Int?
  emergencyDispatchRateMinor Int?
  weekendPremiumMinor       Int?

  @@unique([planId, currency])
  @@map("managed_care_plan_prices")
}

model ManagedCarePlanVersion {
  id              String          @id @default(uuid()) @db.Uuid
  planId          String          @db.Uuid
  plan            ManagedCarePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  versionNumber   Int
  summary         String          @db.VarChar(300)
  changedByAdminId String?        @db.Uuid
  createdAt       DateTime        @default(now())

  @@index([planId, versionNumber])
  @@map("managed_care_plan_versions")
}

enum ManagedPlanStatus {
  ACTIVE
  ARCHIVED

  @@map("managed_plan_status")
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUALLY

  @@map("billing_cycle")
}

// Bounded context: subscription management (the admin Subscriptions workspace). An
// operational overlay keyed to one bookings Subscription, holding the coordinator
// and caregiver assignment, the onboarding dates, the flexible hours ledger, the
// operational event log (activity timeline and audit log) and free text notes. The
// pricing-critical bookings Subscription itself stays lean. Hours are integer tenths
// of an hour.
model SubscriptionOps {
  id                  String    @id @default(uuid()) @db.Uuid
  subscriptionId      String    @unique @db.Uuid
  coordinatorId       String?   @db.Uuid
  caregiverId         String?   @db.Uuid
  contractStartAt     DateTime? @db.Date
  activatedAt         DateTime? @db.Date
  flexAllocatedTenths Int?
  flexConsumedTenths  Int?
  flexCycleEndsAt     DateTime? @db.Date
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  events SubscriptionOpsEvent[]
  notes  SubscriptionOpsNote[]

  @@map("subscription_ops")
}

model SubscriptionOpsEvent {
  id               String                   @id @default(uuid()) @db.Uuid
  opsId            String                   @db.Uuid
  ops              SubscriptionOps          @relation(fields: [opsId], references: [id], onDelete: Cascade)
  type             SubscriptionOpsEventType
  detail           String                   @db.VarChar(300)
  hoursDeltaTenths Int?
  actorAdminId     String?                  @db.Uuid
  actorLabel       String?                  @db.VarChar(80)
  occurredAt       DateTime
  createdAt        DateTime                 @default(now())

  @@index([opsId, occurredAt])
  @@map("subscription_ops_events")
}

model SubscriptionOpsNote {
  id            String          @id @default(uuid()) @db.Uuid
  opsId         String          @db.Uuid
  ops           SubscriptionOps @relation(fields: [opsId], references: [id], onDelete: Cascade)
  body          String          @db.VarChar(2000)
  authorAdminId String?         @db.Uuid
  authorName    String?         @db.VarChar(200)
  createdAt     DateTime        @default(now())

  @@index([opsId, createdAt])
  @@map("subscription_ops_notes")
}

enum SubscriptionOpsEventType {
  CREATED
  ACTIVATED
  RENEWAL_COMPLETED
  HOURS_ADDED
  HOURS_ADJUSTED
  EXPIRY_EXTENDED
  PAUSED
  RESUMED
  CANCELLED
  AUTO_RENEW_ENABLED
  AUTO_RENEW_DISABLED
  COORDINATOR_ASSIGNED
  CAREGIVER_ASSIGNED
  PLAN_CHANGED

  @@map("subscription_ops_event_type")
}

// Bounded context: family directory (the admin Families screen). One entry per
// family member. An account entry links to an identity user (name, phone and email
// composed live); a contact entry captures those inline. Either way the entry owns
// the admin managed fields (status, quick notes, emergency contact verified flag,
// primary recipient). The human readable reference renders as FAM-{sequence}.
model FamilyDirectoryEntry {
  id                       String                     @id @default(uuid()) @db.Uuid
  sequence                 Int                        @unique @default(autoincrement())
  subjectKind              FamilyDirectorySubjectKind
  userId                   String?                    @unique @db.Uuid
  fullName                 String                     @db.VarChar(200)
  phone                    String?                    @db.VarChar(40)
  email                    String?                    @db.VarChar(255)
  relationship             String?                    @db.VarChar(120)
  primaryRecipientId       String?                    @db.Uuid
  status                   FamilyMemberStatus         @default(ACTIVE)
  quickNotes               String?                    @db.VarChar(1000)
  emergencyContactVerified Boolean                    @default(false)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@index([status])
  @@map("family_directory_entries")
}

enum FamilyDirectorySubjectKind {
  ACCOUNT
  CONTACT

  @@map("family_directory_subject_kind")
}

enum FamilyMemberStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION

  @@map("family_member_status")
}

// Bounded context: caregiver profile (the admin Caregivers screen). One profile per
// caregiver identity user, holding the admin managed employment details, skills,
// languages, emergency contact and notes. The personal details (name, phone, email,
// address, date of birth) are read live from the user, never duplicated. The human
// readable reference renders as CG-{sequence}.
model CaregiverProfile {
  id                           String                  @id @default(uuid()) @db.Uuid
  sequence                     Int                     @unique @default(autoincrement())
  userId                       String                  @unique @db.Uuid
  title                        String?                 @db.VarChar(120)
  gender                       Gender?
  branch                       String?                 @db.VarChar(120)
  supervisorName               String?                 @db.VarChar(200)
  employmentType               CaregiverEmploymentType?
  experienceYears              Int?
  joinedAt                     DateTime?               @db.Date
  status                       CaregiverStatus         @default(ACTIVE)
  skills                       String[]                @default([])
  languages                    String[]                @default([])
  emergencyContactName         String?                 @db.VarChar(200)
  emergencyContactPhone        String?                 @db.VarChar(40)
  emergencyContactRelationship String?                 @db.VarChar(80)
  emergencyContactEmail        String?                 @db.VarChar(255)
  maxHoursPerWeek              Int?
  preferredShift               String?                 @db.VarChar(40)
  preferencesNote              String?
  areasForGrowth               String[]                @default([])
  archivedAt                   DateTime?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  notes CaregiverProfileNote[]

  @@index([status])
  @@map("caregiver_profiles")
}

model CaregiverProfileNote {
  id            String           @id @default(uuid()) @db.Uuid
  profileId     String           @db.Uuid
  profile       CaregiverProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  body          String           @db.VarChar(2000)
  authorAdminId String?          @db.Uuid
  authorName    String?          @db.VarChar(200)
  createdAt     DateTime         @default(now())

  @@index([profileId, createdAt])
  @@map("caregiver_profile_notes")
}

enum CaregiverEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT

  @@map("caregiver_employment_type")
}

enum CaregiverStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE

  @@map("caregiver_status")
}

// Bounded context: KYC (identity verification of the family owner).
//
// US owners verify the last four of their SSN through Stripe; Nigeria owners
// verify a NIN or international passport through QoreID. Only a masked reference
// (last four) and the provider's reference are stored, never the full number.
model KycVerification {
  id                String           @id @default(uuid()) @db.Uuid
  ownerId           String           @unique @db.Uuid
  country           Country
  provider          KycProvider
  // Learned from the provider; null for the US until the Stripe session completes.
  documentType      KycDocumentType?
  // The details the owner claimed, kept to compare against the provider record
  // and for the admin audit. Sensitive; never logged.
  claimedFirstName   String          @db.VarChar(100)
  claimedLastName    String          @db.VarChar(100)
  claimedDateOfBirth DateTime        @db.Date
  maskedReference   String?          @db.VarChar(20)
  providerReference String?          @db.VarChar(200)
  faceMatch         FaceMatchOutcome?
  // Fields that did not match the provider record ([{field, provided, returned}]),
  // stored for the admin audit only. Sensitive; never logged.
  mismatches        Json?
  status            KycStatus        @default(PENDING)
  verifiedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("kyc_verifications")
}

enum KycProvider {
  STRIPE
  QOREID

  @@map("kyc_provider")
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
  FAILED

  @@map("kyc_status")
}

enum KycDocumentType {
  NIN
  DRIVERS_LICENSE
  PASSPORT

  @@map("kyc_document_type")
}

enum FaceMatchOutcome {
  MATCH
  NO_MATCH
  NOT_AVAILABLE

  @@map("face_match_outcome")
}

// ---------------------------------------------------------------------------
// Admin bounded contexts (the operations back office). Admins authenticate
// through a separate identity system from the mobile app: their own account
// table, their own JWT secrets and their own session records. A mobile User and
// an AdminUser never share credentials or tokens.
// ---------------------------------------------------------------------------

// An operations back office account (operations manager, coordinator, super
// admin). Provisioned out of band, never self registered. Only the password
// hash is stored; hashing is an application concern performed through a port.
model AdminUser {
  id                 String      @id @default(uuid()) @db.Uuid
  firstName          String      @db.VarChar(100)
  lastName           String      @db.VarChar(100)
  email              String      @unique @db.VarChar(255)
  passwordHash       String      @db.VarChar(255)
  role               AdminRole   @default(COORDINATOR)
  status             AdminStatus @default(ACTIVE)
  // Opaque storage key for the admin's avatar (upload deferred, key only).
  photoKey           String?     @db.VarChar(500)
  // True for an account provisioned with a temporary password; login succeeds
  // but signals the client to force a change. Any password change clears it.
  mustChangePassword Boolean     @default(false)
  passwordChangedAt  DateTime    @default(now())
  lastLoginAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  sessions AdminSession[]

  @@index([status])
  @@map("admin_users")
}

// A signed in admin session behind a rotating refresh token. The refresh token
// hash lives here and is rotated in place on every refresh, so the session keeps
// one identity across the life of the device. Revoking a session (or all of an
// admin's sessions on a password change) logs that device out.
model AdminSession {
  id               String    @id @default(uuid()) @db.Uuid
  adminUserId      String    @db.Uuid
  deviceLabel      String    @db.VarChar(120)
  ipAddress        String?   @db.VarChar(64)
  userAgent        String?   @db.VarChar(400)
  currentTokenHash String?   @unique @db.VarChar(64)
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_sessions")
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS_MANAGER
  COORDINATOR

  @@map("admin_role")
}

enum AdminStatus {
  ACTIVE
  SUSPENDED

  @@map("admin_status")
}

// An operations alert: a system flagged abnormality a coordinator must action
// (a late caregiver, a missed clock in, an expiring certification, a medication
// discrepancy). Raised by the operations subsystems, listed on the dashboard and
// closed when a coordinator resolves or dismisses it.
model OperationalAlert {
  id                     String        @id @default(uuid()) @db.Uuid
  type                   AlertType
  severity               AlertSeverity
  title                  String        @db.VarChar(160)
  description            String        @db.VarChar(500)
  coordinatorName        String?       @db.VarChar(120)
  status                 AlertStatus   @default(OPEN)
  relatedVisitId         String?       @db.Uuid
  relatedCaregiverId     String?       @db.Uuid
  relatedCareRecipientId String?       @db.Uuid
  createdAt              DateTime      @default(now())
  resolvedAt             DateTime?
  resolvedByAdminId      String?       @db.Uuid

  @@index([status, createdAt])
  @@index([relatedVisitId])
  @@map("operational_alerts")
}

enum AlertType {
  LATE_CAREGIVER
  MISSED_CLOCK_IN
  CERTIFICATION_EXPIRING
  MEDICATION_ISSUE
  GENERAL

  @@map("alert_type")
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("alert_severity")
}

enum AlertStatus {
  OPEN
  RESOLVED
  DISMISSED

  @@map("alert_status")
}

// An operational task: a unit of back office work a coordinator tracks (chase a
// document, follow up a complaint, arrange cover). The dashboard counts the tasks
// that are not done as Open Tasks.
model OperationalTask {
  id                     String       @id @default(uuid()) @db.Uuid
  title                  String       @db.VarChar(160)
  description            String?      @db.VarChar(1000)
  status                 TaskStatus   @default(OPEN)
  priority               TaskPriority @default(MEDIUM)
  assignedToAdminId      String?      @db.Uuid
  createdByAdminId       String?      @db.Uuid
  relatedCareRecipientId String?      @db.Uuid
  dueAt                  DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  completedAt            DateTime?

  @@index([status, createdAt])
  @@index([assignedToAdminId])
  @@map("operational_tasks")
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE

  @@map("task_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

// A family member's satisfaction rating (1 to 5) for the care a recipient
// received, optionally tied to a visit. The dashboard reads the average as the
// Client Satisfaction figure. Capture surface (family rating screen) deferred.
model CareRating {
  id                   String            @id @default(uuid()) @db.Uuid
  careRecipientId      String?           @db.Uuid
  caregiverId          String?           @db.Uuid
  visitId              String?           @db.Uuid
  submittedByUserId    String?           @db.Uuid
  submittedByAdminId   String?           @db.Uuid
  reviewerType         RatingReviewerType @default(FAMILY)
  reviewerName         String?           @db.VarChar(200)
  reviewerRelationship String?           @db.VarChar(80)
  score                Int
  comment              String?           @db.VarChar(1000)
  traits               String[]          @default([])
  createdAt            DateTime          @default(now())

  @@index([careRecipientId])
  @@index([caregiverId, createdAt])
  @@index([createdAt])
  @@map("care_ratings")
}

// Who authored a care rating: a family member (from the mobile app) or a care
// coordinator (from the admin back office). Coordinator reviews are captured on
// the caregiver Performance tab.
enum RatingReviewerType {
  FAMILY
  COORDINATOR

  @@map("rating_reviewer_type")
}

// A caregiver credential with an expiry (for example a CPR certificate). The
// operations dashboard watches these to raise a Certification Expiring alert, and
// the caregiver Documents tab lists them with a derived status. The stored file is
// an opaque documentKey; blob storage and signed downloads are deferred.
model Certification {
  id            String         @id @default(uuid()) @db.Uuid
  caregiverId   String         @db.Uuid
  name          String         @db.VarChar(120)
  kind          CredentialKind @default(CERTIFICATION)
  licenseNumber String?        @db.VarChar(120)
  issuedAt      DateTime?
  expiresAt     DateTime
  documentKey   String?        @db.VarChar(500)
  fileName      String?        @db.VarChar(255)
  uploadedBy    String?        @db.VarChar(120)
  createdAt     DateTime       @default(now())

  @@index([expiresAt])
  @@index([caregiverId])
  @@map("certifications")
}

// The kind of credential, which drives the status label the Documents tab shows
// while the credential is in date (a licence or certification reads Valid, a
// background check reads Cleared, a health screening reads Current).
enum CredentialKind {
  LICENSE
  CERTIFICATION
  BACKGROUND_CHECK
  HEALTH_SCREENING
  OTHER

  @@map("credential_kind")
}

// Bounded context: caregiver documents (the Documents tab). An employment document
// is an HR record on file (contract, tax form, agreement); a training record is a
// completed or in progress course. The file itself is an opaque documentKey; blob
// storage and signed downloads are deferred.
model CaregiverDocument {
  id           String                  @id @default(uuid()) @db.Uuid
  caregiverId  String                  @db.Uuid
  name         String                  @db.VarChar(200)
  category     CaregiverDocumentCategory
  status       CaregiverDocumentStatus @default(ACTIVE)
  documentDate DateTime?               @db.Date
  documentKey  String?                 @db.VarChar(500)
  fileName     String?                 @db.VarChar(255)
  uploadedBy   String?                 @db.VarChar(120)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([caregiverId])
  @@map("caregiver_documents")
}

model CaregiverTraining {
  id             String                  @id @default(uuid()) @db.Uuid
  caregiverId    String                  @db.Uuid
  name           String                  @db.VarChar(200)
  status         CaregiverTrainingStatus @default(COMPLETED)
  completedAt    DateTime?               @db.Date
  certificate    Boolean                 @default(false)
  hoursCompleted Int                     @default(0)
  hoursRequired  Int?
  documentKey    String?                 @db.VarChar(500)
  fileName       String?                 @db.VarChar(255)
  uploadedBy     String?                 @db.VarChar(120)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([caregiverId])
  @@map("caregiver_trainings")
}

enum CaregiverDocumentCategory {
  LEGAL
  TAX
  PAYROLL
  HR
  OTHER

  @@map("caregiver_document_category")
}

enum CaregiverDocumentStatus {
  ACTIVE
  CURRENT
  VERIFIED
  SIGNED
  EXPIRED
  ARCHIVED

  @@map("caregiver_document_status")
}

enum CaregiverTrainingStatus {
  COMPLETED
  IN_PROGRESS

  @@map("caregiver_training_status")
}
