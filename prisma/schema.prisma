// Prisma schema for the Anu Heritage Homecare API.
// Docs: https://www.prisma.io/docs
//
// Persistence is an infrastructure concern. Prisma models below are database
// rows only. They are mapped to and from rich domain entities inside each
// bounded context's infrastructure layer, so the domain never depends on Prisma.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Sample bounded context: Clients (care recipients).
model Client {
  id        String       @id @default(uuid()) @db.Uuid
  firstName String       @db.VarChar(100)
  lastName  String       @db.VarChar(100)
  email     String       @unique @db.VarChar(255)
  phone     String       @db.VarChar(32)
  status    ClientStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status])
  @@map("clients")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("client_status")
}

// Bounded context: Identity (mobile users, authentication).
//
// A user is a caregiver or a family member. Family owners self register on the
// mobile app; caregivers are onboarded later. Credentials, one time codes and
// refresh tokens are always stored hashed, never in clear.
model User {
  id            String     @id @default(uuid()) @db.Uuid
  userType      UserType
  firstName     String     @db.VarChar(100)
  lastName      String     @db.VarChar(100)
  email         String     @unique @db.VarChar(255)
  phone         String     @unique @db.VarChar(20)
  addressLine1  String     @db.VarChar(200)
  addressLine2  String?    @db.VarChar(200)
  city          String     @db.VarChar(120)
  state         String     @db.VarChar(120)
  postalCode    String     @db.VarChar(20)
  country       Country
  passwordHash  String     @db.VarChar(255)
  emailVerified Boolean    @default(false)
  phoneVerified Boolean    @default(false)
  isFamilyOwner Boolean    @default(false)
  status        UserStatus @default(PENDING_VERIFICATION)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  verificationCodes VerificationCode[]
  refreshTokens     RefreshToken[]

  @@index([status])
  @@map("users")
}

// One time passcode issued for email verification or password reset. The code
// itself is stored only as a hash; expiry, single use and attempt caps are
// enforced in the domain.
model VerificationCode {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    VerificationPurpose
  codeHash   String              @db.VarChar(255)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                 @default(0)
  createdAt  DateTime            @default(now())

  @@index([userId, purpose])
  @@map("verification_codes")
}

// Persisted refresh token (stored hashed) enabling rotation and revocation.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum UserType {
  CAREGIVER
  FAMILY_MEMBER

  @@map("user_type")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum Country {
  US
  NG

  @@map("country")
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("verification_purpose")
}

// Bounded context: Care recipients (the "loved one" a family owner onboards).
//
// A family owner creates a digital identity for each member receiving care
// through a multi step wizard. The record is created as a DRAFT holding the
// identity profile, then progressively enriched with care needs, health and
// medication information and a care schedule before being finalised (ACTIVE).
//
// `ownerId` references the identity User aggregate by id only. Aggregates in
// different bounded contexts are linked by identifier without a database foreign
// key, so each context owns its own consistency boundary. Health and medication
// data is sensitive personal data and is never logged.
model CareRecipient {
  id      String              @id @default(uuid()) @db.Uuid
  ownerId String              @db.Uuid
  status  CareRecipientStatus @default(DRAFT)

  // Resume pointer: the wizard step to send the owner back to if they leave and
  // return mid onboarding.
  onboardingStep OnboardingStep @default(CARE_NEEDS)

  // Step 1: identity profile (always present from draft creation).
  name            String   @db.VarChar(200)
  gender          Gender
  dateOfBirth     DateTime @db.Date
  city            String   @db.VarChar(120)
  state           String   @db.VarChar(120)
  fullAddress     String   @db.VarChar(300)
  relationship    String   @db.VarChar(120)
  livingSituation String   @db.VarChar(120)
  photoKey        String?  @db.VarChar(500)

  // Step 2: care needs (empty until the step is completed).
  careNeeds CareNeed[] @default([])

  // Step 3: health and medication information (null until the step is completed).
  medicalConditions  String[] @default([])
  allergies          String[] @default([])
  needsMedicationHelp Boolean?
  medications        String[] @default([])

  // Step 4: care schedule (null until the step is completed).
  careFrequency     CareFrequency?
  estimatedStartDate DateTime?     @db.Date
  expectedDuration  String?        @db.VarChar(120)

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerId])
  @@index([ownerId, status])
  @@map("care_recipients")
}

enum CareRecipientStatus {
  DRAFT
  ACTIVE

  @@map("care_recipient_status")
}

enum Gender {
  MALE
  FEMALE

  @@map("gender")
}

enum CareNeed {
  BATHING
  DRESSING
  GROOMING
  TOILETING
  MEAL_PREPARATION
  HOUSEKEEPING
  LAUNDRY
  SHOPPING

  @@map("care_need")
}

enum CareFrequency {
  ONE_TIME_VISIT
  DAILY
  WEEKLY
  LIVE_IN_CARE

  @@map("care_frequency")
}

enum OnboardingStep {
  PROFILE
  CARE_NEEDS
  HEALTH
  SCHEDULE
  REVIEW
  COMPLETED

  @@map("onboarding_step")
}

// Bounded context: Care plans (the catalog the family owner chooses from).
//
// Reference data: the four plans, how each is billed, the hour options for the
// hourly plan, and the price in each supported currency. Money is stored as an
// integer number of minor units (cents, kobo) to avoid floating point rounding.
model CarePlan {
  id           String       @id @default(uuid()) @db.Uuid
  type         CarePlanType @unique
  name         String       @db.VarChar(120)
  description  String       @db.VarChar(300)
  billingModel BillingModel
  allowedHours Int[]        @default([])
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  prices CarePlanPrice[]

  @@map("care_plans")
}

// The price of a plan in one currency. `unitAmountMinor` is the hourly rate for
// an hourly plan or the monthly price for a monthly plan.
model CarePlanPrice {
  id              String   @id @default(uuid()) @db.Uuid
  planId          String   @db.Uuid
  plan            CarePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  currency        Currency
  unitAmountMinor Int
  serviceFeeMinor Int      @default(0)

  @@unique([planId, currency])
  @@map("care_plan_prices")
}

// Bounded context: Bookings (a one time hourly booking for the Flexible plan).
//
// Pricing is snapshotted at creation so later catalog changes never rewrite past
// orders. `ownerId` and `careRecipientId` reference other contexts by id only.
model Booking {
  id              String       @id @default(uuid()) @db.Uuid
  ownerId         String       @db.Uuid
  careRecipientId String       @db.Uuid
  planType        CarePlanType
  hours           Int
  serviceDate     DateTime     @db.Date
  startMinute     Int
  endMinute       Int
  currency        Currency
  hourlyRateMinor Int
  subtotalMinor   Int
  serviceFeeMinor Int
  totalMinor      Int
  status          BookingStatus @default(PENDING_PAYMENT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([ownerId])
  @@index([careRecipientId])
  @@map("bookings")
}

// A recurring monthly subscription for the Standard, Premium or Live in plans.
model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  ownerId           String             @db.Uuid
  careRecipientId   String             @db.Uuid
  planType          CarePlanType
  startDate         DateTime           @db.Date
  currency          Currency
  monthlyPriceMinor Int
  status            SubscriptionStatus @default(PENDING_PAYMENT)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([ownerId])
  @@index([careRecipientId])
  @@map("subscriptions")
}

enum Currency {
  USD
  NGN

  @@map("currency")
}

enum BillingModel {
  HOURLY
  MONTHLY

  @@map("billing_model")
}

enum CarePlanType {
  FLEXIBLE
  STANDARD_MONTHLY
  PREMIUM
  LIVE_IN

  @@map("care_plan_type")
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED

  @@map("booking_status")
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  CANCELLED

  @@map("subscription_status")
}
