// Prisma schema for the Anu Heritage Homecare API.
// Docs: https://www.prisma.io/docs
//
// Persistence is an infrastructure concern. Prisma models below are database
// rows only. They are mapped to and from rich domain entities inside each
// bounded context's infrastructure layer, so the domain never depends on Prisma.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Sample bounded context: Clients (care recipients).
model Client {
  id        String       @id @default(uuid()) @db.Uuid
  firstName String       @db.VarChar(100)
  lastName  String       @db.VarChar(100)
  email     String       @unique @db.VarChar(255)
  phone     String       @db.VarChar(32)
  status    ClientStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status])
  @@map("clients")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("client_status")
}

// Bounded context: Identity (mobile users, authentication).
//
// A user is a caregiver or a family member. Family owners self register on the
// mobile app; caregivers are onboarded later. Credentials, one time codes and
// refresh tokens are always stored hashed, never in clear.
model User {
  id            String     @id @default(uuid()) @db.Uuid
  userType      UserType
  firstName     String     @db.VarChar(100)
  lastName      String     @db.VarChar(100)
  email         String     @unique @db.VarChar(255)
  phone         String     @unique @db.VarChar(20)
  addressLine1  String     @db.VarChar(200)
  addressLine2  String?    @db.VarChar(200)
  city          String     @db.VarChar(120)
  state         String     @db.VarChar(120)
  postalCode    String     @db.VarChar(20)
  country       Country
  // Optional personal details surfaced on the profile; not captured at
  // registration, so nullable until the owner fills them in.
  dateOfBirth            DateTime? @db.Date
  relationshipToRecipient String?  @db.VarChar(120)
  passwordHash  String     @db.VarChar(255)
  emailVerified Boolean    @default(false)
  phoneVerified Boolean    @default(false)
  // Opaque storage key for the user's profile photo (upload deferred, key only).
  photoKey      String?    @db.VarChar(500)
  isFamilyOwner Boolean    @default(false)
  // True for an account provisioned with a temporary password (for example a
  // caregiver onboarded by an admin). Login still succeeds but signals the client
  // to force a password change; any password change clears the flag.
  mustChangePassword Boolean @default(false)
  // Two factor authentication (TOTP). When enabled, login requires a valid
  // authenticator code after the password. The secret is stored encrypted at
  // rest (AES 256 GCM) and never leaves the application in the clear.
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String? @db.VarChar(255)
  // Account security preferences and the password age shown on the security screen.
  passwordChangedAt     DateTime @default(now())
  biometricEnabled      Boolean  @default(false)
  sessionTimeoutMinutes Int      @default(15)
  status        UserStatus @default(PENDING_VERIFICATION)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  verificationCodes  VerificationCode[]
  deviceSessions     DeviceSession[]
  loginEvents        LoginEvent[]
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]

  @@index([status])
  @@map("users")
}

// A single use backup code for two factor authentication. Only the hash is
// stored (the codes are high entropy, so a fast deterministic hash is used for
// indexed lookup). A code is consumed exactly once; a fresh set replaces the old
// one when two factor is re enabled.
model TwoFactorRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @db.VarChar(255)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([codeHash])
  @@map("two_factor_recovery_codes")
}

// One time passcode issued for email verification or password reset. The code
// itself is stored only as a hash; expiry, single use and attempt caps are
// enforced in the domain.
model VerificationCode {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    VerificationPurpose
  codeHash   String              @db.VarChar(255)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                 @default(0)
  createdAt  DateTime            @default(now())

  @@index([userId, purpose])
  @@map("verification_codes")
}

// Persisted refresh token (stored hashed) enabling rotation and revocation.
// A signed in device (a session). The rotating refresh token hash lives here and
// is rotated in place on every refresh, so the session keeps one identity for the
// life of the device. Backs the Trusted Devices screen and "log out everywhere".
model DeviceSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceLabel      String    @db.VarChar(120)
  ipAddress        String?   @db.VarChar(64)
  userAgent        String?   @db.VarChar(400)
  currentTokenHash String?   @unique @db.VarChar(255)
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime
  revokedAt        DateTime?

  @@index([userId])
  @@map("device_sessions")
}

// An attributable login attempt (success or failure) for a known account. Feeds
// the Login Activity screen; only attempts tied to a user are recorded.
model LoginEvent {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcome     LoginOutcome
  deviceLabel String?      @db.VarChar(120)
  ipAddress   String?      @db.VarChar(64)
  userAgent   String?      @db.VarChar(400)
  createdAt   DateTime     @default(now())

  @@index([userId, createdAt])
  @@map("login_events")
}

enum LoginOutcome {
  SUCCESS
  FAILURE

  @@map("login_outcome")
}

enum UserType {
  CAREGIVER
  FAMILY_MEMBER

  @@map("user_type")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED

  @@map("user_status")
}

enum Country {
  US
  NG

  @@map("country")
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("verification_purpose")
}

// Bounded context: Care recipients (the "loved one" a family owner onboards).
//
// A family owner creates a digital identity for each member receiving care
// through a multi step wizard. The record is created as a DRAFT holding the
// identity profile, then progressively enriched with care needs, health and
// medication information and a care schedule before being finalised (ACTIVE).
//
// `ownerId` references the identity User aggregate by id only. Aggregates in
// different bounded contexts are linked by identifier without a database foreign
// key, so each context owns its own consistency boundary. Health and medication
// data is sensitive personal data and is never logged.
model CareRecipient {
  id      String              @id @default(uuid()) @db.Uuid
  ownerId String              @db.Uuid
  status  CareRecipientStatus @default(DRAFT)

  // Resume pointer: the wizard step to send the owner back to if they leave and
  // return mid onboarding.
  onboardingStep OnboardingStep @default(CARE_NEEDS)

  // Step 1: identity profile (always present from draft creation).
  name            String   @db.VarChar(200)
  gender          Gender
  dateOfBirth     DateTime @db.Date
  city            String   @db.VarChar(120)
  state           String   @db.VarChar(120)
  fullAddress     String   @db.VarChar(300)
  relationship    String   @db.VarChar(120)
  livingSituation String   @db.VarChar(120)
  photoKey        String?  @db.VarChar(500)

  // Pinned location of the address, captured at onboarding. Required before a
  // caregiver can clock in, since the arrival geofence is computed against it.
  latitude  Float?
  longitude Float?

  // Step 2: care needs (empty until the step is completed).
  careNeeds CareNeed[] @default([])

  // Step 3: health and medication information (null until the step is completed).
  // Free text conditions and allergies stay on the row; the medication schedule is
  // a structured child collection so a caregiver can record what was done with each
  // dose during a visit (see MedicationAdministration in the visits context).
  medicalConditions  String[] @default([])
  allergies          String[] @default([])
  needsMedicationHelp Boolean?
  medications        Medication[]

  // Care goals are set by the office (for example Maintain independence, Fall
  // prevention), not by the family owner. Surfaced read only on the family care
  // plan; the office capture surface is deferred to the admin module.
  careGoals CareGoal[]

  // Step 4: care schedule (null until the step is completed). The recurring
  // pattern (which weekdays, the start time in minutes from midnight, and how
  // long each visit lasts in minutes) is optional and may be refined after
  // onboarding by the family owner.
  careFrequency     CareFrequency?
  estimatedStartDate DateTime?     @db.Date
  expectedDuration  String?        @db.VarChar(120)
  careDays          Weekday[]      @default([])
  careStartMinute   Int?
  careVisitDurationMinutes Int?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerId])
  @@index([ownerId, status])
  @@map("care_recipients")
}

// One prescribed medication on a care recipient's schedule. Structured so the
// caregiver can see the name, dose and time of day and record administration
// against a specific entry. `scheduleMinute` is minutes from midnight (timezone
// free), null when the family did not pin a time. Owned by the CareRecipient
// aggregate and replaced wholesale when the health step is saved.
model Medication {
  id              String        @id @default(uuid()) @db.Uuid
  careRecipientId String        @db.Uuid
  name            String        @db.VarChar(200)
  dose            String?       @db.VarChar(60)
  scheduleMinute  Int?
  position        Int
  createdAt       DateTime      @default(now())

  careRecipient CareRecipient @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)

  @@index([careRecipientId])
  @@map("medications")
}

// One office set goal for a care recipient's plan (for example Maintain
// independence). Owned by the recipient and surfaced read only on the family
// care plan; ordered by position. The office capture path is deferred.
model CareGoal {
  id              String   @id @default(uuid()) @db.Uuid
  careRecipientId String   @db.Uuid
  label           String   @db.VarChar(200)
  achieved        Boolean  @default(false)
  position        Int
  createdAt       DateTime @default(now())

  careRecipient CareRecipient @relation(fields: [careRecipientId], references: [id], onDelete: Cascade)

  @@index([careRecipientId])
  @@map("care_goals")
}

enum CareRecipientStatus {
  DRAFT
  ACTIVE

  @@map("care_recipient_status")
}

enum Gender {
  MALE
  FEMALE

  @@map("gender")
}

enum CareNeed {
  BATHING
  DRESSING
  GROOMING
  TOILETING
  MEAL_PREPARATION
  HOUSEKEEPING
  LAUNDRY
  SHOPPING

  @@map("care_need")
}

enum CareFrequency {
  ONE_TIME_VISIT
  DAILY
  WEEKLY
  LIVE_IN_CARE

  @@map("care_frequency")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("weekday")
}

enum OnboardingStep {
  PROFILE
  CARE_NEEDS
  HEALTH
  SCHEDULE
  REVIEW
  COMPLETED

  @@map("onboarding_step")
}

// Bounded context: Care plans (the catalog the family owner chooses from).
//
// Reference data: the four plans, how each is billed, the hour options for the
// hourly plan, and the price in each supported currency. Money is stored as an
// integer number of minor units (cents, kobo) to avoid floating point rounding.
model CarePlan {
  id           String       @id @default(uuid()) @db.Uuid
  type         CarePlanType @unique
  name         String       @db.VarChar(120)
  description  String       @db.VarChar(300)
  billingModel BillingModel
  allowedHours Int[]        @default([])
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  prices CarePlanPrice[]

  @@map("care_plans")
}

// The price of a plan in one currency. `unitAmountMinor` is the hourly rate for
// an hourly plan or the monthly price for a monthly plan.
model CarePlanPrice {
  id              String   @id @default(uuid()) @db.Uuid
  planId          String   @db.Uuid
  plan            CarePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  currency        Currency
  unitAmountMinor Int
  serviceFeeMinor Int      @default(0)

  // Recurring billing references at the provider for monthly plans: a Stripe
  // recurring Price id (USD) and a Paystack plan code (NGN).
  stripePriceId    String? @db.VarChar(200)
  paystackPlanCode String? @db.VarChar(200)

  @@unique([planId, currency])
  @@map("care_plan_prices")
}

// Bounded context: Bookings (a one time hourly booking for the Flexible plan).
//
// Pricing is snapshotted at creation so later catalog changes never rewrite past
// orders. `ownerId` and `careRecipientId` reference other contexts by id only.
model Booking {
  id              String       @id @default(uuid()) @db.Uuid
  ownerId         String       @db.Uuid
  careRecipientId String       @db.Uuid
  planType        CarePlanType
  hours           Int
  serviceDate     DateTime     @db.Date
  startMinute     Int
  endMinute       Int
  currency        Currency
  hourlyRateMinor Int
  subtotalMinor   Int
  serviceFeeMinor Int
  totalMinor      Int
  status          BookingStatus @default(PENDING_PAYMENT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([ownerId])
  @@index([careRecipientId])
  @@map("bookings")
}

// A scheduled care session assigning a caregiver to a care recipient on a given
// day and time window. How visits are created and assigned (from bookings and
// subscriptions, or by an admin) is not built yet; this models the execution
// record the caregiver schedule reads. Recipient facing detail (name, health,
// address) is not duplicated here; it is read from the care recipients context.
model Visit {
  id                  String      @id @default(uuid()) @db.Uuid
  caregiverId         String      @db.Uuid
  careRecipientId     String      @db.Uuid
  scheduledDate       DateTime    @db.Date
  startMinute         Int
  endMinute           Int
  status              VisitStatus @default(SCHEDULED)
  specialInstructions String[]
  // Attendance, stamped server side when the caregiver clocks in and out. The
  // arrival coordinates record where the geofenced clock in was accepted.
  clockInAt         DateTime?
  clockOutAt        DateTime?
  arrivalLatitude   Float?
  arrivalLongitude  Float?
  // Photos the caregiver attached during the visit. Opaque storage references
  // (the upload endpoint is deferred). The notes feed lives in the VisitNote model.
  photoKeys  String[] @default([])
  // The caregiver's qualitative observations for the visit (mood, appetite,
  // mobility, whether medication was taken). Short free text, health related.
  observationMood       String? @db.VarChar(120)
  observationAppetite   String? @db.VarChar(120)
  observationMobility   String? @db.VarChar(120)
  observationMedication String? @db.VarChar(120)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  tasks                    VisitTask[]
  medicationAdministrations MedicationAdministration[]
  vitals                   VisitVitals[]
  breaks                   VisitBreak[]
  notes                    VisitNote[]

  @@index([caregiverId, scheduledDate])
  @@index([careRecipientId])
  @@map("visits")
}

// Who a visit note is written for: the internal care team, or the family.
enum NoteAudience {
  CARE_TEAM
  FAMILY

  @@map("note_audience")
}

// A single note a caregiver writes on a visit, part of an append only feed. The
// author is a user id (resolved to a name and role by the reading side); the text
// is sensitive free text about the recipient and is kept out of logs.
model VisitNote {
  id        String       @id @default(uuid()) @db.Uuid
  visitId   String       @db.Uuid
  authorId  String       @db.Uuid
  audience  NoteAudience @default(FAMILY)
  text      String       @db.VarChar(4000)
  createdAt DateTime     @default(now())

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId, createdAt])
  @@map("visit_notes")
}

// A break a caregiver takes during a visit. Append only interval: `startedAt` is
// stamped when the break begins and `endedAt` when it ends (null while the break
// is open). Total break time is the sum of the closed intervals, and an open
// interval means the visit is ON_BREAK. Owned by the Visit aggregate.
model VisitBreak {
  id        String    @id @default(uuid()) @db.Uuid
  visitId   String    @db.Uuid
  startedAt DateTime
  endedAt   DateTime?

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("visit_breaks")
}

// What the caregiver did with one scheduled medication during a visit: either it
// was administered or it was not, with a reason. `medicationId` references a
// Medication in the care recipients context by id only (no cross context foreign
// key). One record per medication per visit. Owned by the Visit aggregate.
model MedicationAdministration {
  id           String                         @id @default(uuid()) @db.Uuid
  visitId      String                         @db.Uuid
  medicationId String                         @db.Uuid
  outcome      MedicationAdministrationOutcome
  note         String?                        @db.VarChar(500)
  recordedAt   DateTime

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([visitId, medicationId])
  @@index([visitId])
  @@map("medication_administrations")
}

// A set of vital signs a caregiver recorded during a visit. Append only: each
// submission is a new reading stamped server side, so the history is preserved.
// Every measure is optional; at least one is present. Weight is stored in whole
// grams to avoid floating point. Owned by the Visit aggregate.
model VisitVitals {
  id                String   @id @default(uuid()) @db.Uuid
  visitId           String   @db.Uuid
  systolic          Int?
  diastolic         Int?
  heartRate         Int?
  oxygenSaturation  Int?
  weightGrams       Int?
  // Body temperature in whole tenths of a degree Celsius (36.8 C = 368).
  temperatureTenths Int?
  recordedAt        DateTime

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("visit_vitals")
}

enum MedicationAdministrationOutcome {
  ADMINISTERED
  REFUSED
  OUT_OF_STOCK
  PATIENT_ASLEEP

  @@map("medication_administration_outcome")
}

// An emergency alert a caregiver raises from an active shift (the SOS button).
// High signal: stored with the caregiver's current position and a snapshot of the
// care recipient's details (name, address, pinned location) so a responder can act
// without a live join. The caregiver can cancel an alert they raised in error.
// Coordinates, the recipient name and the address are sensitive and kept out of
// the logs. `visitId` and `careRecipientId` reference other rows by id only.
model SosAlert {
  id          String         @id @default(uuid()) @db.Uuid
  caregiverId String         @db.Uuid
  visitId     String         @db.Uuid
  latitude    Float?
  longitude   Float?
  // Snapshot of the care recipient at the moment the alert was raised.
  careRecipientId   String  @db.Uuid
  recipientName     String? @db.VarChar(200)
  recipientAddress  String? @db.VarChar(300)
  recipientLatitude  Float?
  recipientLongitude Float?
  status      SosAlertStatus @default(ACTIVE)
  cancelledAt DateTime?
  createdAt   DateTime       @default(now())

  @@index([caregiverId, createdAt])
  @@index([visitId])
  @@map("sos_alerts")
}

enum SosAlertStatus {
  ACTIVE
  CANCELLED

  @@map("sos_alert_status")
}

// A single task on a visit checklist (for example Blood Pressure, Meal
// Preparation). Owned by the Visit aggregate and replaced wholesale on save.
model VisitTask {
  id          String    @id @default(uuid()) @db.Uuid
  visitId     String    @db.Uuid
  label       String    @db.VarChar(200)
  completed   Boolean   @default(false)
  // When the task was ticked off, so the activity feed can place it on a
  // timeline. Null while the task is not complete.
  completedAt DateTime?
  // How long the task took, in whole minutes. Optional, only set when completed.
  durationMinutes Int?
  position    Int

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("visit_tasks")
}

// A recurring monthly subscription for the Standard, Premium or Live in plans.
model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  ownerId           String             @db.Uuid
  careRecipientId   String             @db.Uuid
  planType          CarePlanType
  startDate         DateTime           @db.Date
  currency          Currency
  monthlyPriceMinor Int
  status            SubscriptionStatus @default(PENDING_PAYMENT)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([ownerId])
  @@index([careRecipientId])
  @@map("subscriptions")
}

enum Currency {
  USD
  NGN

  @@map("currency")
}

// The family owner's emergency contact (Profile). One row per user; distinct from
// the owner's own account details so a different person can be reached in an
// emergency. Owned by the profile context.
model EmergencyContact {
  userId       String   @id @db.Uuid
  name         String   @db.VarChar(200)
  phone        String   @db.VarChar(20)
  relationship String   @db.VarChar(120)
  updatedAt    DateTime @updatedAt

  @@map("emergency_contacts")
}

// One member of a family owner's care circle: an app user granted access to the
// owner's care information at a level. Name and avatar come from the linked user
// (identity). One membership per (owner, user). Owned by the profile context.
model CareCircleMember {
  id           String          @id @default(uuid()) @db.Uuid
  ownerId      String          @db.Uuid
  memberUserId String          @db.Uuid
  relationship String          @db.VarChar(120)
  accessLevel  CareAccessLevel
  createdAt    DateTime        @default(now())

  @@unique([ownerId, memberUserId])
  @@index([memberUserId])
  @@map("care_circle_members")
}

// A short lived bearer credential an owner shares so a family member or friend
// can join their care circle. Not addressed to a person: whoever holds it can
// redeem it while active and unexpired, and it stays reusable within its window.
// Owned by the profile context.
model CareCode {
  id        String         @id @default(uuid()) @db.Uuid
  ownerId   String         @db.Uuid
  code      String         @unique @db.VarChar(40)
  status    CareCodeStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  expiresAt DateTime

  @@index([ownerId, status])
  @@map("care_codes")
}

enum CareAccessLevel {
  LIMITED
  VIEW_ONLY
  FULL

  @@map("care_access_level")
}

enum CareCodeStatus {
  ACTIVE
  REVOKED

  @@map("care_code_status")
}

// A family owner's notification and app preferences (the Profile Preferences and
// Notifications screens). One row per user, created with sensible defaults on
// first read. Owned by the profile context.
// A family owner's per category notification switches, mirroring the
// Notifications screen. One row per user. Marketing is off by default; every
// other category is on.
model ProfilePreferences {
  userId              String  @id @db.Uuid
  // Care Updates
  visitUpdates        Boolean @default(true)
  caregiverUpdates    Boolean @default(true)
  healthAlerts        Boolean @default(true)
  medicationReminders Boolean @default(true)
  // Communications
  messages            Boolean @default(true)
  carePlanUpdates     Boolean @default(true)
  announcements       Boolean @default(true)
  // Billing and Payments
  invoicesAndPayments Boolean @default(true)
  paymentReminders    Boolean @default(true)
  // Marketing
  marketingAndOffers  Boolean @default(false)
  language            String  @default("en") @db.VarChar(10)
  // Preferred contact method: EMAIL, PHONE or SMS.
  preferredContactMethod String @default("EMAIL") @db.VarChar(10)
  // App display preferences (the Preferences screen).
  theme               String  @default("LIGHT") @db.VarChar(10)
  dateFormat          String  @default("MMM_DD_YYYY") @db.VarChar(20)
  timeFormat          String  @default("TWELVE_HOUR") @db.VarChar(20)
  soundEnabled        Boolean @default(true)
  textSize            String  @default("MEDIUM") @db.VarChar(10)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("profile_preferences")
}

// A family owner's private, read only calendar feed. The token in the feed URL is
// the only credential a calendar app can present, so it is a long random secret.
// One per owner; regenerating rotates the token. Owned by the profile context.
model CalendarFeed {
  userId    String   @id @db.Uuid
  token     String   @unique @db.VarChar(64)
  createdAt DateTime @default(now())

  @@map("calendar_feeds")
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID

  @@map("invoice_status")
}

// A bill issued to a family owner for one monthly subscription period. Written by
// the billing run; money is in integer minor units. One per subscription period.
model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  ownerId         String        @db.Uuid
  careRecipientId String        @db.Uuid
  subscriptionId  String        @db.Uuid
  number          String        @unique @db.VarChar(40)
  currency        Currency
  // Money breakdown, snapshotted at issue: subtotal is the sum of the line items,
  // tax is derived from the rate, and amountMinor is the charged total (subtotal
  // plus tax less discount).
  subtotalMinor   Int
  taxRateBps      Int           @default(0)
  taxMinor        Int           @default(0)
  discountMinor   Int           @default(0)
  amountMinor     Int
  periodStart     DateTime      @db.Date
  periodEnd       DateTime      @db.Date
  dueDate         DateTime      @db.Date
  status          InvoiceStatus @default(ISSUED)
  issuedAt        DateTime      @default(now())
  paidAt          DateTime?

  lineItems InvoiceLineItem[]

  @@unique([subscriptionId, periodStart])
  @@index([ownerId, periodStart])
  @@map("invoices")
}

// One service or charge line on an invoice, snapshotted at issue and ordered by
// position. Owned by the Invoice and replaced wholesale when the invoice is saved.
model InvoiceLineItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  description String   @db.VarChar(200)
  amountMinor Int
  position    Int
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

enum BillingModel {
  HOURLY
  MONTHLY

  @@map("billing_model")
}

enum CarePlanType {
  FLEXIBLE
  STANDARD_MONTHLY
  PREMIUM
  LIVE_IN

  @@map("care_plan_type")
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED

  @@map("booking_status")
}

enum VisitStatus {
  SCHEDULED
  IN_PROGRESS
  ON_BREAK
  COMPLETED
  CANCELLED
  MISSED

  @@map("visit_status")
}

// A single location breadcrumb reported by a caregiver's device. Append only and
// high volume: written in batches and read later for the admin movement audit
// (path replay, travel time, long stops). Sent frequently during navigation and
// occasionally in the background, distinguished by `mode`. `visitId` is an
// optional tag; it is not a foreign key so telemetry never blocks on a visit row.
model LocationPing {
  id             String       @id @default(uuid()) @db.Uuid
  caregiverId    String       @db.Uuid
  visitId        String?      @db.Uuid
  // Set on points streamed at high frequency while an SOS alert is active, so the
  // emergency path can be replayed. A tag only; not a foreign key.
  sosAlertId     String?      @db.Uuid
  latitude       Float
  longitude      Float
  accuracyMeters Float?
  mode           LocationMode
  recordedAt     DateTime
  receivedAt     DateTime     @default(now())

  @@index([caregiverId, recordedAt])
  @@index([visitId])
  @@index([sosAlertId])
  @@map("location_pings")
}

enum LocationMode {
  NAVIGATION
  BACKGROUND
  EMERGENCY

  @@map("location_mode")
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  CANCELLED

  @@map("subscription_status")
}

// Bounded context: Payments.
//
// A payment charges for a booking or a subscription through a provider chosen by
// the owner's currency (Stripe for USD, Paystack for NGN). The provider is the
// source of truth for the outcome, confirmed through verification and webhooks.
model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  ownerId           String          @db.Uuid
  payableType       PayableType
  payableId         String          @db.Uuid
  provider          PaymentProvider
  providerReference String          @unique @db.VarChar(200)
  currency          Currency
  amountMinor       Int
  status            PaymentStatus   @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([ownerId])
  @@index([payableType, payableId])
  @@map("payments")
}

// A saved card, tokenised by the provider. The raw card is never stored; only an
// opaque provider reference plus display metadata (brand, last four).
model PaymentMethod {
  id                  String          @id @default(uuid()) @db.Uuid
  ownerId             String          @db.Uuid
  provider            PaymentProvider
  providerCustomerRef String?         @db.VarChar(200)
  providerMethodRef   String          @db.VarChar(200)
  brand               String          @db.VarChar(40)
  last4               String          @db.VarChar(4)
  expMonth            Int
  expYear             Int
  cardHolderName      String?         @db.VarChar(200)
  isDefault           Boolean         @default(false)
  createdAt           DateTime        @default(now())

  @@unique([provider, providerMethodRef])
  @@index([ownerId])
  @@map("payment_methods")
}

enum PaymentProvider {
  STRIPE
  PAYSTACK

  @@map("payment_provider")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED

  @@map("payment_status")
}

enum PayableType {
  BOOKING
  SUBSCRIPTION
  INVOICE

  @@map("payable_type")
}

// Bounded context: Earnings.
//
// The pay rate and rules for one caregiver, used to estimate their earnings for
// the current pay period from the visits they worked. Money is stored as integer
// minor units and rates as basis points to keep the arithmetic free of floating
// point. Values are placeholders until real figures are set; a caregiver without
// a row simply estimates to zero. One row per caregiver.
model CaregiverPayRate {
  id                    String   @id @default(uuid()) @db.Uuid
  caregiverId           String   @unique @db.Uuid
  currency              Currency
  hourlyRateMinor       Int
  // Overtime multiplier in basis points of the hourly rate (15000 = 1.5x).
  overtimeMultiplierBps Int      @default(15000)
  // Regular hours in a pay period before overtime applies.
  regularHoursCap       Int      @default(80)
  // Flat bonus in minor units for each visit worked on a weekend.
  weekendBonusMinor     Int      @default(0)
  // Tax and deductions in basis points of gross pay (250 = 2.5%).
  taxRateBps            Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("caregiver_pay_rates")
}

// A finalized payslip: an immutable snapshot of a caregiver's pay for one closed
// pay period, written by the payroll run. Money is in integer minor units and
// time in whole minutes, matching the earnings calculator. One per caregiver per
// period.
model Payslip {
  id                String   @id @default(uuid()) @db.Uuid
  caregiverId       String   @db.Uuid
  currency          Currency
  periodStart       DateTime @db.Date
  periodEnd         DateTime @db.Date
  payDay            DateTime @db.Date
  workedMinutes     Int
  regularMinutes    Int
  regularPayMinor   Int
  overtimeMinutes   Int
  overtimePayMinor  Int
  weekendVisits     Int
  weekendBonusMinor Int
  grossMinor        Int
  deductionsMinor   Int
  netMinor          Int
  createdAt         DateTime @default(now())

  @@unique([caregiverId, periodStart])
  @@index([caregiverId, periodStart])
  @@map("payslips")
}

// Bounded context: availability (the time windows a caregiver declares they are
// open to work, one record per caregiver per day).
model CaregiverAvailability {
  id          String   @id @default(uuid()) @db.Uuid
  caregiverId String   @db.Uuid
  date        DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slots CaregiverAvailabilitySlot[]

  @@unique([caregiverId, date])
  @@index([caregiverId, date])
  @@map("caregiver_availability")
}

model CaregiverAvailabilitySlot {
  id             String @id @default(uuid()) @db.Uuid
  availabilityId String @db.Uuid
  // Minutes from midnight, timezone free, matching the visit window convention.
  startMinute    Int
  endMinute      Int

  availability CaregiverAvailability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)

  @@index([availabilityId])
  @@map("caregiver_availability_slots")
}

// Bounded context: care requests (a family owner asks for an extra care session).
enum CareRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED

  @@map("care_request_status")
}

model AdditionalCareRequest {
  id              String            @id @default(uuid()) @db.Uuid
  ownerId         String            @db.Uuid
  careRecipientId String            @db.Uuid
  careType        String            @db.VarChar(100)
  requestedDate   DateTime          @db.Date
  // Requested start time as minutes from midnight (timezone free), and duration.
  startMinute     Int
  durationMinutes Int
  reason          String?           @db.VarChar(1000)
  status          CareRequestStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([careRecipientId, createdAt])
  @@index([ownerId])
  @@map("additional_care_requests")
}

// Bounded context: KYC (identity verification of the family owner).
//
// US owners verify the last four of their SSN through Stripe; Nigeria owners
// verify a NIN or international passport through QoreID. Only a masked reference
// (last four) and the provider's reference are stored, never the full number.
model KycVerification {
  id                String           @id @default(uuid()) @db.Uuid
  ownerId           String           @unique @db.Uuid
  country           Country
  provider          KycProvider
  // Learned from the provider; null for the US until the Stripe session completes.
  documentType      KycDocumentType?
  // The details the owner claimed, kept to compare against the provider record
  // and for the admin audit. Sensitive; never logged.
  claimedFirstName   String          @db.VarChar(100)
  claimedLastName    String          @db.VarChar(100)
  claimedDateOfBirth DateTime        @db.Date
  maskedReference   String?          @db.VarChar(20)
  providerReference String?          @db.VarChar(200)
  faceMatch         FaceMatchOutcome?
  // Fields that did not match the provider record ([{field, provided, returned}]),
  // stored for the admin audit only. Sensitive; never logged.
  mismatches        Json?
  status            KycStatus        @default(PENDING)
  verifiedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("kyc_verifications")
}

enum KycProvider {
  STRIPE
  QOREID

  @@map("kyc_provider")
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
  FAILED

  @@map("kyc_status")
}

enum KycDocumentType {
  NIN
  DRIVERS_LICENSE
  PASSPORT

  @@map("kyc_document_type")
}

enum FaceMatchOutcome {
  MATCH
  NO_MATCH
  NOT_AVAILABLE

  @@map("face_match_outcome")
}

// ---------------------------------------------------------------------------
// Admin bounded contexts (the operations back office). Admins authenticate
// through a separate identity system from the mobile app: their own account
// table, their own JWT secrets and their own session records. A mobile User and
// an AdminUser never share credentials or tokens.
// ---------------------------------------------------------------------------

// An operations back office account (operations manager, coordinator, super
// admin). Provisioned out of band, never self registered. Only the password
// hash is stored; hashing is an application concern performed through a port.
model AdminUser {
  id                 String      @id @default(uuid()) @db.Uuid
  firstName          String      @db.VarChar(100)
  lastName           String      @db.VarChar(100)
  email              String      @unique @db.VarChar(255)
  passwordHash       String      @db.VarChar(255)
  role               AdminRole   @default(COORDINATOR)
  status             AdminStatus @default(ACTIVE)
  // Opaque storage key for the admin's avatar (upload deferred, key only).
  photoKey           String?     @db.VarChar(500)
  // True for an account provisioned with a temporary password; login succeeds
  // but signals the client to force a change. Any password change clears it.
  mustChangePassword Boolean     @default(false)
  passwordChangedAt  DateTime    @default(now())
  lastLoginAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  sessions AdminSession[]

  @@index([status])
  @@map("admin_users")
}

// A signed in admin session behind a rotating refresh token. The refresh token
// hash lives here and is rotated in place on every refresh, so the session keeps
// one identity across the life of the device. Revoking a session (or all of an
// admin's sessions on a password change) logs that device out.
model AdminSession {
  id               String    @id @default(uuid()) @db.Uuid
  adminUserId      String    @db.Uuid
  deviceLabel      String    @db.VarChar(120)
  ipAddress        String?   @db.VarChar(64)
  userAgent        String?   @db.VarChar(400)
  currentTokenHash String?   @unique @db.VarChar(64)
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_sessions")
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS_MANAGER
  COORDINATOR

  @@map("admin_role")
}

enum AdminStatus {
  ACTIVE
  SUSPENDED

  @@map("admin_status")
}
