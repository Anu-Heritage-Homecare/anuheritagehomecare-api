  ownerId   String         @db.Uuid
  code      String         @unique @db.VarChar(40)
  status    CareCodeStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  expiresAt DateTime

  @@index([ownerId, status])
  @@map("care_codes")
