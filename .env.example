# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_DEFAULT_VERSION=1
# Public base URL of this API (used to build the absolute calendar feed link).
APP_PUBLIC_URL=http://localhost:3000

# Security
# Comma separated list of allowed CORS origins. Use explicit origins in production, never "*".
CORS_ORIGINS=http://localhost:3000
# Requests allowed per client within the throttle window.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://anu_app:change_me_locally@localhost:5432/anuheritage?schema=public

# Logging
LOG_LEVEL=debug

# OpenAPI docs HTTP Basic auth. In production the docs are served at /api/docs only
# when both are set, behind this basic auth. Ignored in development (docs are open).
SWAGGER_USER=
SWAGGER_PASSWORD=

# Authentication (JWT)
# Use long, random, distinct secrets per purpose. At least 32 characters each.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars_long
JWT_REFRESH_TTL=30d
JWT_RESET_SECRET=change_me_reset_secret_at_least_32_chars_long
JWT_RESET_TTL=10m
# Short lived token for the two factor login challenge (own secret and lifetime)
JWT_MFA_SECRET=change_me_mfa_secret_at_least_32_chars_long
JWT_MFA_TTL=5m
# bcrypt cost factor (10 to 15). Higher is slower and stronger.
BCRYPT_SALT_ROUNDS=12

# Admin back office authentication. Entirely separate secrets from the mobile
# app tokens above; an admin token can never authenticate a mobile route.
JWT_ADMIN_ACCESS_SECRET=change_me_admin_access_secret_at_least_32_chars
JWT_ADMIN_ACCESS_TTL=15m
JWT_ADMIN_REFRESH_SECRET=change_me_admin_refresh_secret_at_least_32_chars
JWT_ADMIN_REFRESH_TTL=12h

# Two factor authentication (TOTP). The encryption key protects the stored TOTP
# secret at rest; the issuer is the label shown in the authenticator app.
TWO_FACTOR_ENCRYPTION_KEY=change_me_two_factor_key_at_least_32_chars_long
TWO_FACTOR_ISSUER=Anu Heritage Homecare

# One time passcodes (email verification and password reset)
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Outbound email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Anu Heritage Homecare <no-reply@anuheritagehomecare.com>

# Bookable hours in a day (local), used to generate Flexible booking time slots
BOOKING_DAY_START_HOUR=8
BOOKING_DAY_END_HOUR=21

# Arrival geofence radius (metres): how close a caregiver must be to a care
# recipient's pinned address to clock in
GEOFENCE_RADIUS_METERS=150

# Payment providers. Stripe serves USD, Paystack serves NGN. Leave blank to
# disable a provider; the adapter fails closed if used without its key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Where Paystack redirects the user after payment (optional)
PAYMENT_CALLBACK_URL=
# Nominal minor units charged to tokenise a reusable Paystack card, refunded
# after saving (Paystack only returns a reusable card after a real charge).
PAYSTACK_CARD_SETUP_AMOUNT_MINOR=5000

# KYC. US owners verify via Stripe (reuses STRIPE_SECRET_KEY); Nigeria owners
# verify a NIN or passport via QoreID. Leave blank to disable.
QOREID_CLIENT_ID=
QOREID_SECRET=
QOREID_BASE_URL=https://api.qoreid.com
# Signing secret for the Stripe Identity webhook endpoint (US KYC completion)
STRIPE_IDENTITY_WEBHOOK_SECRET=

# Sales tax rate on billing, in basis points, per market (333 = 3.33%). Leave 0
# to add no tax until the real rates are known.
BILLING_TAX_BPS_US=0
BILLING_TAX_BPS_NG=0

# Cloudinary photo storage for visit photos. The client uploads directly with a
# server issued signature, so the api secret stays on the server. Optional; the
# adapter fails closed for uploads if the secret is empty.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=anu/visits
