# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_DEFAULT_VERSION=1

# Security
# Comma separated list of allowed CORS origins. Use explicit origins in production, never "*".
CORS_ORIGINS=http://localhost:3000
# Requests allowed per client within the throttle window.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://anu_app:change_me_locally@localhost:5432/anuheritage?schema=public

# Logging
LOG_LEVEL=debug
