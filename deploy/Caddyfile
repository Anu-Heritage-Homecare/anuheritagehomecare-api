# Caddy reverse proxy with automatic HTTPS.
#
# DOMAIN is read from the environment (.env). It must be a real domain whose DNS
# A record points at this VPS; Caddy then provisions and renews a Let's Encrypt
# certificate automatically. The API listens on port 3000 inside the compose
# network and is never exposed directly.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy api:3000

	header {
		# Harden responses at the edge; the app also sets helmet headers.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
}
