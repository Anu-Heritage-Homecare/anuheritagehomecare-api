# Production environment reference (the full key list the backend needs).
#
# Doppler (project "homecare", config "prd") is the source of truth in production:
# the deploy pipeline pulls these from Doppler and writes /opt/anu-heritage/.env on
# the VPS, so you do NOT normally hand edit this on the server. Keep this file as a
# reference of every key. NEVER commit a filled in .env or any token.
# Generate secrets with: openssl rand -base64 48

# Application
NODE_ENV=production
PORT=3000
API_PREFIX=api
API_DEFAULT_VERSION=1
# Public base URL of this API (used to build the absolute calendar feed link).
APP_PUBLIC_URL=https://api.example.com

# Public domain for the API. TLS and reverse proxying are handled on the host by
# nginx + certbot (not by the container); this value is informational for the app.
# The domain's DNS A record must point at the VPS public IP.
DOMAIN=api.example.com

# Security. Comma separated allowed CORS origins (the frontend origins). Never "*".
CORS_ORIGINS=https://app.example.com
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# Database: the managed CloudClusters PostgreSQL.
DATABASE_URL=postgresql://Devs:REPLACE_WITH_REAL_PASSWORD@postgresql-215539-0.cloudclusters.net:10018/careprofs?schema=public

# Logging
LOG_LEVEL=info

# OpenAPI docs HTTP Basic auth. Set both to publish /api/docs in production behind
# basic auth; leave empty to keep the docs disabled in production.
SWAGGER_USER=
SWAGGER_PASSWORD=

# Authentication (JWT). Distinct strong secrets, at least 32 characters each.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d
JWT_RESET_SECRET=
JWT_RESET_TTL=10m
JWT_MFA_SECRET=
JWT_MFA_TTL=5m
BCRYPT_SALT_ROUNDS=12

# Admin back office authentication (entirely separate secrets).
JWT_ADMIN_ACCESS_SECRET=
JWT_ADMIN_ACCESS_TTL=15m
JWT_ADMIN_REFRESH_SECRET=
JWT_ADMIN_REFRESH_TTL=12h

# Two factor authentication (TOTP).
TWO_FACTOR_ENCRYPTION_KEY=
TWO_FACTOR_ISSUER=Anu Heritage Homecare

# One time passcodes (email verification and password reset).
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Outbound email (SMTP). Required: SMTP_HOST.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Anu Heritage Homecare <no-reply@anuheritagehomecare.com>

# Bookable hours in a day (local).
BOOKING_DAY_START_HOUR=8
BOOKING_DAY_END_HOUR=21

# Arrival geofence radius (metres).
GEOFENCE_RADIUS_METERS=150

# Caregiver pay period.
EARNINGS_PAY_PERIOD_DAYS=14
EARNINGS_PAY_PERIOD_ANCHOR=2026-01-01T00:00:00.000Z
EARNINGS_PAYDAY_OFFSET_DAYS=1

# Payment providers (optional; adapters fail closed without keys).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYMENT_CALLBACK_URL=
PAYSTACK_CARD_SETUP_AMOUNT_MINOR=5000

# KYC (optional; adapters fail closed without keys).
QOREID_CLIENT_ID=
QOREID_SECRET=
QOREID_BASE_URL=https://api.qoreid.com
STRIPE_IDENTITY_WEBHOOK_SECRET=

# Sales tax rate per market, in basis points.
BILLING_TAX_BPS_US=0
BILLING_TAX_BPS_NG=0

# Cloudinary photo storage (optional; adapter fails closed for uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=anu/visits
